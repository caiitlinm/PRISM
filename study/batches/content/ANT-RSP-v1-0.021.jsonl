{"unit_id": "ANT-RSP-v1-0-0301", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-3 Evaluations for Misuse Risks", "locator": "list item 2, sentence 2", "unit_type": "numbered", "context_stem": "Capabilities:", "excerpt": "This requires both defining the current baseline in a clear way, and defining what a significant increase to risk would look like.", "paraphrase": "This requires clearly defining both the current baseline and what constitutes a significant risk increase.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0302", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-3 Evaluations for Misuse Risks", "locator": "list item 3", "unit_type": "numbered", "context_stem": "NONE", "excerpt": "Evaluations: For such capabilities, we will seek to define which measurable properties suggest that a model provides or will provide this capability upon further scaling. These \"warning sign evaluations\" will then be run on the model as described in the Evaluation Protocol section.", "paraphrase": "Measurable warning-sign properties indicating emerging capability will be defined and run as evaluations per the Evaluation Protocol.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0303", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-3 Evaluations for Misuse Risks", "locator": "para 3, sentence 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We are not yet publishing our first work in this area, which will be a more systematized extension of our previous work on biological capabilities.", "paraphrase": "The first systematized work extending prior biological capability research is not yet published.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0304", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-3 Evaluations for Misuse Risks", "locator": "para 3, sentence 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "However, we will look to share as much as is useful and safe to relevant parties, such as parties facing similar deployment decisions.", "paraphrase": "Anthropic intends to share as much useful and safe information as possible with relevant parties facing similar deployment decisions.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0305", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-3 Evaluations for Misuse Risks", "locator": "para 4, sentence 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We stress that this will be hard and require iteration. There are fundamental uncertainties and disagreements about every layer—what threat models are right, which capabilities matter, what increase in risk is meaningful, what our current risk is, what the right evaluations are, and how to perform those evaluations.", "paraphrase": "The work will be difficult and iterative, given fundamental uncertainties and disagreements at every layer of the analysis.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0306", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-3 Evaluations for Misuse Risks", "locator": "para 4, sentence 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "It will take time, consultation with experts, and continual updating.", "paraphrase": "Progress will require time, expert consultation, and ongoing revision.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0307", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "para 1, sentence 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "At ASL-2, labs should defend model weights and code against opportunistic attackers.", "paraphrase": "ASL-2 requires defending model weights and code against opportunistic attackers.", "modal_register": "conditional", "stated_bar": "ASL-2", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0308", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "para 1, sentence 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We commit to the following security themes, and they are a superset of our recent voluntary commitments.", "paraphrase": "Anthropic commits to the listed security themes, which expand upon prior voluntary commitments.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0309", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "para 1, sentence 3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This summary previews some key security measures at a high level and is based on a forthcoming report by Sella Nevo, RAND; Dan Lahav, Pattern Labs; and others on securing AI model weights.", "paraphrase": "The summary is a high-level preview based on an upcoming report on securing AI model weights by named experts.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0310", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "para 1, sentence 4", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will publish a more comprehensive list of our implemented ASL-2 security measures (with additional components not listed here) following the report's publication.", "paraphrase": "A fuller list of implemented ASL-2 security measures will be published after the report is released.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0311", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 1, sentence 1", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Vendor and supplier security must be regularly reviewed to ensure that they meet security standards.", "paraphrase": "Vendor and supplier security must undergo regular review against security standards.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0312", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 1, sentence 2", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Software updates should be frequently managed and compliance monitoring automated where possible.", "paraphrase": "Software updates should be managed frequently, with compliance monitoring automated where feasible.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0313", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 2, sentence 1", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Physical security should entail visitor access logs and restrictions protect on-site assets.", "paraphrase": "Physical security should include visitor access logs and restrictions to protect on-site assets.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
