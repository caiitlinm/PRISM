{"unit_id": "ANT-RSP-v3-3-0016", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We aspire to advance the latter through a mixture of example-setting, addressing unsolved technical problems, advocacy through industry groups, and policy advocacy.", "paraphrase": "Anthropic aspires to promote the industry-wide recommendations via example-setting, technical work, and advocacy.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0017", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "But we cannot commit to following them unilaterally.", "paraphrase": "Anthropic cannot unilaterally commit to the industry-wide recommendations.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0018", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Frontier Safety Roadmaps are a new requirement under our RSP.", "paraphrase": "The RSP introduces Frontier Safety Roadmaps as a new requirement.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0019", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "These will describe our concrete plans for making progress across Security, Alignment, Safeguards, and Policy.", "paraphrase": "The Roadmaps will lay out concrete plans across four domains: Security, Alignment, Safeguards, and Policy.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0020", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Goals described in the Roadmaps are intended to be ambitious, yet achievable—providing the kind of forcing function that we consider to be a past success of our RSP.", "paraphrase": "Roadmap goals are meant to be ambitious yet achievable, serving as a forcing function that has worked well in the RSP's past.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0021", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "These are not hard commitments but rather public goals against which we will openly grade our progress.", "paraphrase": "Roadmap goals are not binding commitments but public benchmarks for self-assessed progress.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0022", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Risk Reports are another new requirement.", "paraphrase": "Risk Reports are introduced as another new requirement.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0023", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Risk Reports will provide detailed information on the safety profile of our models at the time of publication.", "paraphrase": "Risk Reports will detail the safety profile of models as of publication.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0024", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "They will go beyond describing model capabilities, addressing our thinking on how capabilities, threat models (the specific ways that models might pose threats), and active risk mitigations fit together, providing an assessment of the overall level of risk.", "paraphrase": "Risk Reports will connect capabilities, threat models, and mitigations to give an overall risk assessment, beyond just capability descriptions.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0025", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "These reports will reflect our reasoning as to whether we believe the risks of training or deploying our models are justified by their corresponding benefits to the world.", "paraphrase": "Risk Reports will reflect reasoning about whether the risks of training/deployment are justified by benefits.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0026", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "They will be published online, with some redactions to protect sensitive details about, for example, our training methods and organizations with whom we work.", "paraphrase": "Risk Reports will be published online with redactions to protect sensitive information like training methods and partner organizations.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0027", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "As detailed below, we also aim to subject Risk Reports to review by credible, independent external parties.", "paraphrase": "Anthropic aims to have Risk Reports reviewed by credible independent external parties.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0028", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Finally, our governance commitments are intended to promote internal and external accountability, similar to those in our previous RSP.", "paraphrase": "Governance commitments aim to promote internal and external accountability, similar to the prior RSP's approach.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0029", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Our RSP is only one part of our overall approach to safety.", "paraphrase": "The RSP is only one component of Anthropic's broader safety approach.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0030", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "Introduction", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "For instance, although this policy focuses on catastrophic risks, they are not the only risks we consider important—our Usage Policy and societal impacts research address other concerns.", "paraphrase": "While the RSP focuses on catastrophic risk, other concerns are addressed by the Usage Policy and societal impacts research.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
