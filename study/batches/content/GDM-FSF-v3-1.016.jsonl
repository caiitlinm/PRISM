{"unit_id": "GDM-FSF-v3-1-0234", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.1", "framework_year": 2026, "section_heading": "Glossary / Model", "locator": "Glossary / Model", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Frontier AI Models or Models: are trained on a large data set, display significant generality, are capable of performing a wide range of distinctive tasks and have high-impact capabilities.", "paraphrase": "Frontier AI models are defined as large-dataset-trained, highly general models capable of diverse tasks and high-impact capabilities.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "GDM-FSF-v3-1-0235", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.1", "framework_year": 2026, "section_heading": "Glossary / Model", "locator": "Glossary / Model", "unit_type": "paragraph", "context_stem": "Frontier AI Models or Models definition", "excerpt": "Frontier AI models' agentic and reasoning-based general capabilities near or exceed those of other Google models.", "paraphrase": "Frontier AI models have agentic and reasoning capabilities that approach or surpass those of other Google models.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "GDM-FSF-v3-1-0236", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.1", "framework_year": 2026, "section_heading": "Glossary / Model", "locator": "Glossary / Model", "unit_type": "paragraph", "context_stem": "Frontier AI Models or Models definition", "excerpt": "There may be many different checkpoints and versions of the same model along the entire model lifecycle: we consider checkpoints and versions the same model if their base capabilities stem primarily from the same foundational training run, but will conduct additional testing on new versions as specified in Section 1.3.", "paraphrase": "Different checkpoints or versions sharing the same foundational training run are considered the same model, though new versions still receive additional testing per Section 1.3.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "GDM-FSF-v3-1-0237", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.1", "framework_year": 2026, "section_heading": "Glossary / Model", "locator": "Glossary / Model", "unit_type": "paragraph", "context_stem": "Frontier AI Models or Models definition", "excerpt": "When we refer to \"model\" in this Framework, we may be referring to a checkpoint or version of the model.", "paraphrase": "References to \"model\" in the Framework may denote a checkpoint or version of that model.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
