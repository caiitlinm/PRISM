{"unit_id": "ANT-RSP-v1-0-0323", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 4, sentence 3", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Strict protocols must be deployed to regulate weight copies on company networks and limit storage to only approved, restricted systems.", "paraphrase": "Strict protocols must govern weight copies on company networks and restrict storage to approved systems only.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0324", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 5, sentence 1", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Standard security infrastructure, monitoring software, access management tools, and disk encryption provide a technology baseline but should be extended further by monitoring for scaled abuse that performs prompt-based model detail extraction (e.g. distillation attacks).", "paraphrase": "Standard security tools form a baseline that should be extended by monitoring for scaled prompt-based extraction attacks such as distillation.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0325", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 5, sentence 2", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Process elements like incident reporting procedures, lost/stolen device protocols and Detection and Response should support these.", "paraphrase": "Process elements such as incident reporting, lost/stolen device protocols, and Detection and Response should support the technology baseline.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
