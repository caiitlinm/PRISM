{"unit_id": "ANT-RSP-v1-0-0321", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 4, sentence 1", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Segmented system isolation must ensure limited blast radius.", "paraphrase": "Segmented isolation of systems must limit the impact scope of a breach.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
