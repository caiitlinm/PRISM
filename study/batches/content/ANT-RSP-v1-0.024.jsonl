{"unit_id": "ANT-RSP-v1-0-0350", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 6", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Organizational policies must aim to enforce security through code, limiting reliance on manual compliance.", "paraphrase": "Policies must seek to enforce security programmatically rather than through manual compliance.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v1-0-0351", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 1.0", "framework_year": 2023, "section_heading": "ASL-2 and ASL-3 Security Commitments", "locator": "bullet 7, sentence 1", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "To scale to meet the risk from people-vectors, insider threat programs should be hardened to require multi-party controls and incentivize reporting risks.", "paraphrase": "Insider threat programs should be strengthened with multi-party controls and reporting incentives to address people-based risk.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
