{"unit_id": "ANT-RSP-v3-3-0121", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "2. Frontier Safety Roadmap", "locator": "2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Our Frontier Safety Roadmap is subject to change.", "paraphrase": "The Roadmap may be changed.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0122", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "2. Frontier Safety Roadmap", "locator": "2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Some changes may simply reflect our evolving understanding of how best to mitigate key risks.", "paraphrase": "Some Roadmap changes may reflect evolving understanding of risk mitigation.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0123", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "2. Frontier Safety Roadmap", "locator": "2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "However, we will strive to avoid situations where we revise the goals in a less ambitious direction simply because we are unable to achieve them.", "paraphrase": "Anthropic will strive not to weaken goals merely because they prove hard to achieve.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0124", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "2. Frontier Safety Roadmap", "locator": "2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "By establishing this expectation, we hope to create a forcing function for work that would otherwise be challenging to appropriately prioritize and resource, as it requires collaboration (and in some cases sacrifices) from multiple parts of the company and can be at cross-purposes with immediate competitive and commercial priorities.", "paraphrase": "This expectation is meant to create a forcing function for cross-company collaborative work that competes with commercial priorities.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0125", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "2. Frontier Safety Roadmap", "locator": "2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Publishing our Frontier Safety Roadmap may also help inform broader industry and policy discussions on AI safety.", "paraphrase": "Publishing the Roadmap could help inform wider industry and policy discussions.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0126", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "2. Frontier Safety Roadmap", "locator": "2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Our current Frontier Safety Roadmap is available at anthropic.com/responsible-scaling-policy/roadmap.", "paraphrase": "The current Roadmap is published at a specified URL.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0127", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "2. Frontier Safety Roadmap", "locator": "2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will also keep past Roadmaps available at that link.", "paraphrase": "Past Roadmap versions will remain accessible at the same link.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0128", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "3. Risk Reports", "locator": "3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will publish Risk Reports discussing the risks of our systems and how we have made determinations about whether to continue AI development and deployment in light of the risks.", "paraphrase": "Anthropic commits to publishing Risk Reports that discuss system risks and the determinations made about continuing AI development and deployment.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0129", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "3. Risk Reports", "locator": "3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "These have significant content in common with system cards, but we are adding additional structure and process aimed at presenting our overall assessments of risk.", "paraphrase": "Risk Reports overlap with system cards but include added structure and process for presenting overall risk assessments.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0130", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "3.1. Scope and Timing", "locator": "3.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "A Risk Report will cover all publicly deployed models at the time of its publication.", "paraphrase": "Each Risk Report covers all models publicly deployed as of its publication date.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0131", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "3.1. Scope and Timing", "locator": "3.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "It will also cover internally deployed models that we determine (1) could pose risks related to high-stakes misalignment or automated R&D that (2) significantly exceed those posed by models covered by a prior Risk Report.", "paraphrase": "Risk Reports also cover internal models judged to pose materially greater misalignment or automated R&D risk than previously covered models.", "modal_register": "mandatory", "stated_bar": "significantly exceed those posed by models covered by a prior Risk Report", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0132", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "3.1. Scope and Timing", "locator": "3.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "While there are a variety of reasons we might classify an internal model this way, this will—at a minimum—include any internal models that we are deploying for large-scale, fully autonomous research.", "paraphrase": "At minimum, models deployed internally for large-scale fully autonomous research will be classified as in-scope.", "modal_register": "mandatory", "stated_bar": "large-scale, fully autonomous research", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0133", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "3.1. Scope and Timing", "locator": "3.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Models fitting the above description are abbreviated below as “in-scope models.”", "paraphrase": "Models meeting the described criteria are referred to as in-scope models.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v3-3-0134", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.3", "framework_year": 2026, "section_heading": "3.1. Scope and Timing", "locator": "3.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We may also voluntarily include additional models in a Risk Report, e.g., to contribute to general discourse, but such inclusion does not expand the commitments below.", "paraphrase": "Additional models may be voluntarily included for discourse purposes, without expanding the stated commitments.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
