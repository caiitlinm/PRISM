{"unit_id": "GDM-FSF-v3-0-0180", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "5.2 Disclosures", "locator": "5.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "If we assess that a model has reached a CCL that poses an unmitigated and material risk to overall public safety, we aim to share relevant information with appropriate government authorities where it will facilitate safety of frontier AI.", "paraphrase": "If a model reaches a CCL posing unmitigated material risk to public safety, GDM aims to share relevant information with government authorities where it aids frontier AI safety.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
