{"unit_id": "ANT-RSP-v3-2-0042", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.2", "framework_year": 2026, "section_heading": "1. Our Recommendations for Industry-Wide Safety", "locator": "1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The distinction between our plans as a company (middle column) and our industry-wide recommendations (right column) reflects the limitations of any single AI developer's ability to ensure safety across the industry.", "paraphrase": "The company/industry-wide distinction reflects that a single developer cannot ensure industry-wide safety alone.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
