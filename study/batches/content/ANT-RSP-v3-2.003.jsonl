{"unit_id": "ANT-RSP-v3-2-0034", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.2", "framework_year": 2026, "section_heading": "Introduction", "locator": "fn1", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "\"Catastrophic risk\" as used in our RSP refers generally to risks of the most severe potential harms from advanced AI, such as existential threats or fundamental destabilization of global systems.", "paraphrase": "Footnote defines catastrophic risk as the most severe potential AI harms, such as existential threats or global destabilization.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
