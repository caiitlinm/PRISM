{"unit_id": "ANT-RSP-v3-2-0037", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.2", "framework_year": 2026, "section_heading": "1. Our Recommendations for Industry-Wide Safety", "locator": "1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This section outlines our recommendations for what it would take, at an industry-wide level, to keep catastrophic risks reliably low through a period of rapid advances in AI capabilities.", "paraphrase": "This section presents recommendations for industry-wide measures to keep catastrophic risk low amid rapid AI progress.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "ANT-RSP-v3-2-0006", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
