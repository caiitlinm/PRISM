{"unit_id": "OAI-PF-2023-0031", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Tracked Risk Categories", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In this section, we identify the categories of risks that we will be tracking, along with a dedicated workstream for identifying and adding new or nascent categories of risk as they emerge, i.e., “unknown unknowns.”", "paraphrase": "This section identifies tracked risk categories and a workstream for adding new emerging risks.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
