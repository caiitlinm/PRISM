{"unit_id": "ANT-RSP-v2-0-0046", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 5", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "By sharing our approach externally, we aim to set a new industry standard that encourages widespread adoption of similar frameworks.", "paraphrase": "Anthropic aims to set an industry standard by sharing its approach externally to encourage similar frameworks elsewhere.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0047", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 5", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In the long term, we hope that our policy may offer relevant insights for regulation.", "paraphrase": "Anthropic hopes the policy will inform future regulation in the long term.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0048", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 5", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In the meantime, we will continue to share our findings with policymakers.", "paraphrase": "Anthropic will continue sharing findings with policymakers in the meantime.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0049", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 6", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Although this policy focuses on catastrophic risks, they are not the only risks that we consider important.", "paraphrase": "The policy focuses on catastrophic risks, but Anthropic considers other risks important too.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0050", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 6", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Our Usage Policy sets forth our standards for the use of our products, including prohibitions on using our models to spread misinformation, incite violence or hateful behavior, or engage in fraudulent or abusive practices, and we continually refine our technical measures for enforcing our trust and safety standards at scale.", "paraphrase": "The Usage Policy prohibits misuse such as misinformation, incitement, and fraud, and Anthropic continually refines enforcement measures at scale.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0051", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 6", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Further, we conduct research to understand the broader societal impacts of our models.", "paraphrase": "Anthropic conducts research into the broader societal impacts of its models.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0052", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 6", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Our Responsible Scaling Policy complements our work in these areas, contributing to our understanding of current and potential risks.", "paraphrase": "The RSP complements other work areas by contributing to understanding of current and potential risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0053", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 7", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "At Anthropic, we are committed to developing AI responsibly and transparently.", "paraphrase": "Anthropic states its commitment to responsible and transparent AI development.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0054", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 7", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Since our founding, we have recognized the importance of proactively addressing potential risks as we push the boundaries of AI capability and of clearly communicating about the nature and extent of those risks.", "paraphrase": "Since its founding, Anthropic has emphasized proactively addressing risks while advancing AI capability and clearly communicating about those risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0055", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 7", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We look forward to continuing to refine our approach to risk governance and to collaborating with stakeholders across the AI ecosystem.", "paraphrase": "Anthropic looks forward to continuing refinement of risk governance and collaboration with the wider AI ecosystem.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0056", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 8", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This policy is designed in the spirit of the Responsible Scaling Policy (RSP) framework introduced by the non-profit AI safety organization METR, as well as emerging government policy proposals in the UK, EU, and US.", "paraphrase": "The policy is inspired by METR's RSP framework and by emerging government proposals in the UK, EU, and US.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0057", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 8", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This policy also helps satisfy our Voluntary White House Commitments (2023) and Frontier AI Safety Commitments (2024).", "paraphrase": "The policy also helps fulfill Anthropic's 2023 Voluntary White House Commitments and 2024 Frontier AI Safety Commitments.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0058", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 8", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We extend our sincere gratitude to the many external groups that provided invaluable guidance on the development and refinement of our Responsible Scaling Policy.", "paraphrase": "Anthropic thanks external groups for guidance on developing and refining the RSP.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
{"unit_id": "ANT-RSP-v2-0-0059", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "NONE", "framework_year": 2024, "section_heading": "Introduction", "locator": "Introduction / para 8", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We actively welcome feedback on our policy and suggestions for improvement from other entities engaged in frontier AI risk evaluations or safety and security standards.", "paraphrase": "Anthropic invites feedback and improvement suggestions from other entities engaged in frontier AI risk work.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "prior_unit_id": "NONE", "transition_id": "NONE"}
