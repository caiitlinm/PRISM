{"unit_id": "ANT-RSP-v3-4-0134", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3. Risk Reports", "locator": "3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will publish Risk Reports discussing the risks of our systems and how we have made determinations about whether to continue AI development and deployment in light of the risks.", "paraphrase": "Anthropic will publish Risk Reports covering system risks and continuation determinations.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "5", "prior_counterpart_excerpt": "Publicly share evaluation results after model deployment where possible, in some cases in the initial model card, in other cases with a delay if it serves a broad safety interest.", "prior_modal_register": "conditional", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "ANT-RSP-v1-0-0161"}
