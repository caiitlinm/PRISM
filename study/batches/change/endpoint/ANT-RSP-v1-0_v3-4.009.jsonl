{"unit_id": "ANT-RSP-v3-4-0130", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "2. Frontier Safety Roadmap", "locator": "2 / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "By establishing this expectation, we hope to create a forcing function for work that would otherwise be challenging to appropriately prioritize and resource, as it requires collaboration (and in some cases sacrifices) from multiple parts of the company and can be at cross-purposes with immediate competitive and commercial priorities.", "paraphrase": "This expectation is meant to force prioritization of cross-company collaborative work that could otherwise conflict with competitive and commercial priorities.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
