{"unit_id": "ANT-RSP-v3-4-0211", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.1. Selecting external reviewers", "locator": "3.6.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In selecting external reviewers, we will consult with the Board and obtain the approval of the LTBT.", "paraphrase": "External reviewer selection involves Board consultation and LTBT approval.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0212", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.2. Timing and access", "locator": "3.6.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The external review process will involve sharing the Risk Report with one or more external reviewers within one week of submitting the same report to our Board and LTBT.", "paraphrase": "The Risk Report will be shared with external reviewers within one week of submission to the Board and LTBT.", "modal_register": "mandatory", "stated_bar": "one week", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0213", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.2. Timing and access", "locator": "3.6.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will ask the external reviewers to provide public commentary on our report within 30 days of receipt.", "paraphrase": "External reviewers will be asked to provide public commentary within 30 days of receiving the report.", "modal_register": "mandatory", "stated_bar": "30 days", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0214", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.2. Timing and access", "locator": "3.6.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will try to work toward a process that involves the full external review being completed prior to Board/LTBT review (and may require this later).", "paraphrase": "Anthropic will work toward completing full external review before Board/LTBT review, potentially making this mandatory later.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0215", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.2. Timing and access", "locator": "3.6.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "All sections of the Risk Report will be shared with at least one external reviewer, but we may choose to split the review process across different external reviewers based on their subject matter expertise.", "paraphrase": "All sections will be shared with at least one reviewer, potentially split across multiple reviewers by expertise.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0216", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.2. Timing and access", "locator": "3.6.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "For purposes of external review, the only redactions to the Risk Report will be those necessary to comply with legal prohibitions or to maintain our legal rights.", "paraphrase": "For external review purposes, redactions are limited to those legally necessary.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0217", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.2. Timing and access", "locator": "3.6.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We expect that we will also invest some time in answering follow-up questions from parties doing external review.", "paraphrase": "Anthropic expects to spend time answering follow-up questions from external reviewers.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0218", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.2. Timing and access", "locator": "fn12", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "For example, we may redact information if sharing it would endanger our legal right to treat it as confidential. This would be an uncommon situation.", "paraphrase": "Redaction may occur to preserve confidentiality rights, though this is expected to be uncommon.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0219", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.2. Timing and access", "locator": "fn12", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "It does not mean we would redact information merely because it is sensitive or to reduce the risk of a leak.", "paraphrase": "Sensitivity alone or leak-risk reduction is not a basis for redaction.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0220", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.3. Contents of external review", "locator": "3.6.3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The external review will address:", "paraphrase": "Lead-in to list of topics addressed by external review.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0221", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.3. Contents of external review", "locator": "3.6.3 / item 1", "unit_type": "numbered", "context_stem": "The external review will address:", "excerpt": "Adequacy of information: Whether the Risk Report contains sufficient information to assess the identified risks;", "paraphrase": "The review assesses whether the report contains sufficient information about identified risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0222", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.3. Contents of external review", "locator": "3.6.3 / item 2", "unit_type": "numbered", "context_stem": "The external review will address:", "excerpt": "Analytical rigor: The strength of the Risk Report's reasoning and analysis;", "paraphrase": "The review assesses the strength of the report's reasoning and analysis.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0223", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.3. Contents of external review", "locator": "3.6.3 / item 3", "unit_type": "numbered", "context_stem": "The external review will address:", "excerpt": "Areas of disagreement: Whether the external reviewer disagrees with any of the Risk Report's key claims and, if so, the reasons for any such disagreements; and", "paraphrase": "The review notes disagreements with key claims and their reasons.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0224", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.3. Contents of external review", "locator": "3.6.3 / item 4", "unit_type": "numbered", "context_stem": "The external review will address:", "excerpt": "Risk reduction recommendations: Recommendations for further reducing identified risks.", "paraphrase": "The review provides recommendations for further reducing identified risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
{"unit_id": "ANT-RSP-v3-4-0225", "source_version": "target", "lab_name": "Anthropic", "framework_name": "Responsible Scaling Policy", "framework_version": "Version 3.4", "framework_year": 2026, "section_heading": "3.6.3. Contents of external review", "locator": "3.6.3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The external reviewer will also evaluate our redaction decisions while avoiding disclosure of the redacted content itself.", "paraphrase": "The reviewer evaluates redaction decisions without disclosing the redacted content.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE", "transition_id": "ANT-RSP-v1-0_v3-4", "prior_unit_id": "NONE"}
