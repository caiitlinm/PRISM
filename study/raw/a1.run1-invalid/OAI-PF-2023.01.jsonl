{"unit_id": "OAI-PF-2023-0089", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Persuasion", "locator": "Table Persuasion / High / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: High; Column: Rationale for threshold", "excerpt": "This has a similar risk profile to a country-wide change agent; it could dramatically affect elections and democratic outcomes.", "paraphrase": "This level poses risks similar to a country-wide change agent, potentially affecting elections significantly.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0090", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Persuasion", "locator": "Table Persuasion / Critical / Definition", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Definition", "excerpt": "Model can create (potentially interactive) content with persuasive effectiveness strong enough to convince almost anyone to take action on a belief that goes against their natural interest.", "paraphrase": "Critical persuasion risk means model content can convince nearly anyone to act against their own interest.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0091", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Persuasion", "locator": "Table Persuasion / Critical / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Rationale for threshold", "excerpt": "This represents a superhuman persuasive threat; it would be a powerful weapon for controlling nation-states, extracting secrets, and interfering with democracy.", "paraphrase": "This represents a superhuman persuasive threat capable of controlling nations and undermining democracy.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0092", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Model autonomy enables actors to run scaled misuse that can adapt to environmental changes and evade attempts to mitigate or shut down operations.", "paraphrase": "Model autonomy allows actors to run adaptable, scalable misuse that resists mitigation or shutdown.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0093", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Autonomy is also a prerequisite for self-exfiltration, self-improvement, and resource acquisition.", "paraphrase": "Autonomy is a prerequisite for self-exfiltration, self-improvement, and resource acquisition.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0094", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / Low / Definition", "unit_type": "table_cell", "context_stem": "Risk level: Low; Column: Definition", "excerpt": "Model can take discrete actions if explicitly instructed to do so.", "paraphrase": "Low autonomy risk means the model can take discrete actions only when explicitly instructed.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0095", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / Low / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Low; Column: Rationale for threshold", "excerpt": "This limits the model to single-step tasks in a \"human assistance\" use case, where the step is generally clear and outcomes are easily understood.", "paraphrase": "This confines the model to single-step, clear human-assistance tasks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0096", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / Medium / Definition", "unit_type": "table_cell", "context_stem": "Risk level: Medium; Column: Definition", "excerpt": "Model can robustly complete a diverse set of chained actions and acquire resources (e.g., spin up an AWS instance, complete a Fiverr task) OR model, with basic scaffolding, can use off-the-shelf software to execute well-specified coding tasks on a standalone, toy, or handcrafted repository", "paraphrase": "Medium autonomy risk means the model can chain actions to acquire resources or execute well-specified coding tasks with basic scaffolding.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0097", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / Medium / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Medium; Column: Rationale for threshold", "excerpt": "Solving well-specified tasks demonstrates a strong understanding of programming and a moderate ability to handle real world errors", "paraphrase": "Solving well-specified tasks shows strong programming understanding and moderate error-handling ability.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0098", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / High / Definition", "unit_type": "table_cell", "context_stem": "Risk level: High; Column: Definition", "excerpt": "Model can execute open-ended, novel ML tasks on a production ML codebase that would constitute a significant step on the critical path to model self-improvement (e.g., an OpenAI pull request that trains a new model with highly diverse datasets to improve codebase editing performance, using internal tooling and documentation).", "paraphrase": "High autonomy risk means the model can execute open-ended novel ML tasks constituting a significant step toward self-improvement.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0099", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / High / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: High; Column: Rationale for threshold", "excerpt": "Solving open-ended tasks offers an immediate speedup for AI research and demonstrates a strong level of long-context understanding and adaptation.", "paraphrase": "Solving open-ended tasks accelerates AI research and shows strong long-context understanding.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0100", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / High / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: High; Column: Rationale for threshold", "excerpt": "However, this does not yet demonstrate the ability to orchestrate continual improvements over time (i.e., improvements may be bounded or evolutionary rather than revolutionary); further, models are still restricted by access to compute and other resources.", "paraphrase": "This level doesn't yet show sustained continual improvement, and models remain limited by compute access.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0101", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / Critical / Definition", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Definition", "excerpt": "Model can profitably survive and replicate in the wild given minimal human instruction, i.e., without listing explicit approaches OR model can self-exfiltrate under current prevailing security OR model can conduct AI research fully autonomously (e.g., autonomously identify and validate a 2x compute efficiency improvement)", "paraphrase": "Critical autonomy risk means the model can self-replicate, self-exfiltrate, or conduct AI research fully autonomously, e.g., achieving a 2x compute efficiency gain.", "modal_register": "none", "stated_bar": "2x compute efficiency improvement", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0102", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / Critical / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Rationale for threshold", "excerpt": "If the model is able to successfully replicate and survive or self-exfiltrate, controlling the model would be very difficult. Such a model might be able to also adapt to humans attempting to shut it down.", "paraphrase": "A self-replicating or self-exfiltrating model would be very difficult to control and might resist shutdown attempts.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0103", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / Critical / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Rationale for threshold", "excerpt": "Finally, such a model would likely be able to create unified, goal-directed plans across a variety of domains (e.g., from running commands on Linux to orchestrating tasks on Fiverr).", "paraphrase": "Such a model would likely create unified goal-directed plans spanning multiple domains.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0104", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "Table Model autonomy / Critical / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Rationale for threshold", "excerpt": "If the model is able to conduct AI research fully autonomously, it could set off an intelligence explosion.", "paraphrase": "Fully autonomous AI research capability could trigger an intelligence explosion.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0105", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "fn3", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "By intelligence explosion, we mean a cycle in which the AI system improves itself, which makes the system more capable of more improvements, creating a runaway process of self-improvement.", "paraphrase": "Intelligence explosion is defined as a self-reinforcing cycle of AI self-improvement.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0106", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Model autonomy", "locator": "fn3", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "A concentrated burst of capability gains could outstrip our ability to anticipate and react to them.", "paraphrase": "A sudden capability surge could exceed the ability to anticipate and respond.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0107", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Unknown unknowns", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The list of Tracked Risk Categories above is almost certainly not exhaustive.", "paraphrase": "The current risk category list is likely incomplete.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0108", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Unknown unknowns", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "As our understanding of the potential impacts and capabilities of frontier models improves, the listing will likely require expansions that accommodate new or understudied, emerging risks.", "paraphrase": "The risk category list will likely expand as understanding of frontier model capabilities improves.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0109", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Unknown unknowns", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Therefore, as a part of our Governance process (described later in this document), we will continually assess whether there is a need for including a new category of risk in the list above and how to create gradations.", "paraphrase": "As part of Governance, OpenAI will continually assess whether new risk categories need adding and how to create gradations.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0110", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Unknown unknowns", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In addition, we will invest in staying abreast of relevant research developments and monitoring for observed misuse (expanded on later in this document), to help us understand if there are any emerging or understudied threats that we need to track.", "paraphrase": "OpenAI will invest in tracking research developments and misuse to identify emerging threats.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0111", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Unknown unknowns", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The initial set of Tracked Risk Categories stems from an effort to identify the minimal set of \"tripwires\" required for the emergence of any catastrophic risk scenario we could reasonably envision.", "paraphrase": "The initial risk categories were chosen to identify minimal tripwires for any conceivable catastrophic risk scenario.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0112", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Unknown unknowns", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Note that we include deception and social engineering evaluations as part of the persuasion risk category, and include autonomous replication, adaptation, and AI R&D as part of the model autonomy risk category.", "paraphrase": "Deception/social engineering are included under persuasion; autonomous replication, adaptation, and AI R&D are included under model autonomy.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0113", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Scorecard", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "As a part of our Preparedness Framework, we will maintain a dynamic (i.e., frequently updated) Scorecard that is designed to track our current pre-mitigation model risk across each of the risk categories, as well as the post-mitigation risk.", "paraphrase": "OpenAI will maintain a frequently updated Scorecard tracking pre- and post-mitigation risk across categories.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0114", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Scorecard", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The Scorecard will be regularly updated by the Preparedness team to help ensure it reflects the latest research and findings.", "paraphrase": "The Preparedness team will regularly update the Scorecard to reflect current research.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0115", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Scorecard", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Sources that inform the updates to the Scorecard will also include tracking observed misuse, and other community red-teaming and input on our frontier models from other teams (e.g., Policy Research, Safety Systems, Superalignment).", "paraphrase": "Scorecard updates will draw on observed misuse tracking, community red-teaming, and input from other teams.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0116", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Pre-mitigation versus post-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will run the same evaluations to determine risk level for both the pre-mitigation and the post-mitigation risk, but on different versions of the model (pre-mitigation vs post-mitigations, as clarified further below).", "paraphrase": "The same evaluations determine pre- and post-mitigation risk but are run on different model versions.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0117", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Pre-mitigation versus post-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In practice, it will likely be the case that the overall post-mitigation risk is lower than the pre-mitigation risk.", "paraphrase": "Post-mitigation risk is expected to typically be lower than pre-mitigation risk.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0118", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Pre-mitigation versus post-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Pre-mitigation risk is meant to guide the level of our security efforts as well as drive the development of mitigations needed to bring down post-mitigation risk.", "paraphrase": "Pre-mitigation risk guides security effort levels and drives mitigation development.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0119", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Pre-mitigation versus post-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In the end, coupling capabilities growth with robust safety solutions is at the core of our research processes, and post-mitigation risk is our way of tracking the overall \"net output\" of these processes.", "paraphrase": "Pairing capability growth with safety solutions is core to research, and post-mitigation risk tracks the net outcome.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0120", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Evaluating pre-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We want to ensure our understanding of pre-mitigation risk takes into account a model that is \"worst known case\" (i.e., specifically tailored) for the given domain.", "paraphrase": "Pre-mitigation risk assessment aims to consider the worst known case, domain-tailored model.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0121", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Evaluating pre-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "To this end, for our evaluations, we will be running them not only on base models (with highly-performant, tailored prompts wherever appropriate), but also on fine-tuned versions designed for the particular misuse vector without any mitigations in place.", "paraphrase": "Evaluations will run on both base models with tailored prompts and fine-tuned versions without mitigations.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0122", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Evaluating pre-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will be running these evaluations continually, i.e., as often as needed to catch any non-trivial capability change, including before, during, and after training.", "paraphrase": "Evaluations will run continually before, during, and after training to catch non-trivial capability changes.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0123", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Evaluating pre-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This would include whenever there is a >2x effective compute increase or major algorithmic breakthrough.", "paraphrase": "Evaluation triggers include a greater than 2x effective compute increase or a major algorithmic breakthrough.", "modal_register": "mandatory", "stated_bar": ">2x effective compute increase", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0124", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Evaluating post-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "To verify if mitigations have sufficiently and dependently reduced the resulting post-mitigation risk, we will also run evaluations on models after they have safety mitigations in place, again attempting to verify and test the possible \"worst known case\" scenario for these systems.", "paraphrase": "Evaluations will also be run post-mitigation to verify sufficient risk reduction, again testing the worst known case.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0125", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Evaluating post-mitigation risk", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "As part of our baseline commitments, we are aiming to keep post-mitigation risk at \"medium\" risk or below.", "paraphrase": "OpenAI's baseline commitment is to keep post-mitigation risk at medium or below.", "modal_register": "aspirational", "stated_bar": "medium", "duplicate_of": "OAI-PF-2023-0012", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0126", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Forecasting, \"early warnings,\" and monitoring", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Many of the mitigations that would be necessary to address risks at a \"high\" or \"critical\" pre-mitigation level (e.g., hardening security) require adequate lead time to implement.", "paraphrase": "Mitigations for high or critical pre-mitigation risks require adequate lead time to implement.", "modal_register": "none", "stated_bar": "high; critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0127", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Forecasting, \"early warnings,\" and monitoring", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "For this reason, we will be investing in efforts that help create an internal \"preparedness roadmap\" and help us thus properly plan for and get ahead of the emerging risks.", "paraphrase": "OpenAI will invest in creating an internal preparedness roadmap to plan ahead of emerging risks.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0128", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Forecasting, \"early warnings,\" and monitoring", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "These efforts will include sustained research related to scaling trends for dangerous capabilities and ongoing monitoring of misuse.", "paraphrase": "Efforts will include sustained research on dangerous capability scaling trends and ongoing misuse monitoring.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0129", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Forecasting, \"early warnings,\" and monitoring", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will also, in cooperation with other teams (e.g., Safety Systems), develop monitoring and investigative systems.", "paraphrase": "OpenAI will develop monitoring and investigative systems in cooperation with other teams.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0130", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Forecasting, \"early warnings,\" and monitoring", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This monitoring of real-world misuse (as well as staying abreast of relevant research developments) will help us create a better picture of deployed model characteristics, and inform updates to our evaluations as necessary.", "paraphrase": "Monitoring real-world misuse and research will improve understanding of deployed models and inform evaluation updates.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}