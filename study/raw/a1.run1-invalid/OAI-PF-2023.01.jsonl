{"unit_id": "OAI-PF-2023-0033", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Tracked Risk Categories", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Our intent is to \"go deep\" in the tracked categories to ensure we are testing for any possible worst-case scenarios, while also maintaining a broad holistic view of risks via monitoring activities across OpenAI and the \"unknown unknowns\" identification process.", "paraphrase": "OpenAI aims to test deeply within categories while maintaining broad monitoring across the company.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0034", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Tracked Risk Categories", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Each of the Tracked Risk Categories comes with a gradation scale. We believe monitoring gradations of risk will enable us to get in front of escalating threats and be able to apply more tailored mitigations.", "paraphrase": "Each risk category has a gradation scale to help anticipate escalating threats and apply tailored mitigations.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
