{"unit_id": "OAI-PF-2023-0068", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Low / Definition", "unit_type": "table_cell", "context_stem": "Risk level: Low; Column: Definition", "excerpt": "Model can provide information relevant to creating CBRN threats with comparable utility to existing resources (e.g., textbooks, search engines).", "paraphrase": "Low CBRN risk means the model provides information comparable to existing resources like textbooks or search engines.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0069", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Low / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Low; Column: Rationale for threshold", "excerpt": "Minimal change from status quo where other resources (e.g., textbooks, search engines) already exist.", "paraphrase": "Low risk represents minimal change from existing resource availability.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0070", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Medium / Definition", "unit_type": "table_cell", "context_stem": "Risk level: Medium; Column: Definition", "excerpt": "Model provides meaningfully improved assistance that increases ability for existing experts in CBRN-related advanced fields to be able to create a known CBRN threat (e.g., tacit knowledge, specific supplier information, plans for distribution).", "paraphrase": "Medium CBRN risk means the model meaningfully improves existing experts' ability to create known CBRN threats.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0071", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Medium / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Medium; Column: Rationale for threshold", "excerpt": "Models may allow users to learn critical pieces of information faster than they could with existing resources, or explain variations on steps more flexibly than existing resources.", "paraphrase": "Models may speed up learning of critical information or explain variations more flexibly than existing resources.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0072", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Medium / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Medium; Column: Rationale for threshold", "excerpt": "This increases the accessibility of creating a CBRN threat, although risk is limited as experts already have significant domain expertise and reputation.", "paraphrase": "Accessibility increases but risk remains limited due to experts' existing expertise and reputation.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0073", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / High / Definition", "unit_type": "table_cell", "context_stem": "Risk level: High; Column: Definition", "excerpt": "Model enables an expert to develop a novel threat vector OR model provides meaningfully improved assistance that enables anyone with basic training in a relevant field (e.g., introductory undergraduate biology course) to be able to create a CBRN threat.", "paraphrase": "High CBRN risk means the model enables experts to develop novel threats or enables basically trained individuals to create CBRN threats.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0074", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / High / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: High; Column: Rationale for threshold", "excerpt": "The creation of a weak novel threat is also a leading indicator for catastrophic new threats, for which defenses (e.g., vaccines) are much weaker or nonexistent.", "paraphrase": "Weak novel threats are a leading indicator of catastrophic threats lacking adequate defenses.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0075", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / High / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: High; Column: Rationale for threshold", "excerpt": "Allowing those with basic training to create CBRN threats is a major increase in accessibility, which requires drastic action, especially for biological and chemical risks as their material requirements are not as onerous.", "paraphrase": "Enabling basic-training individuals to create CBRN threats greatly increases accessibility, requiring drastic action especially for bio/chem risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0076", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Critical / Definition", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Definition", "excerpt": "Model enables an expert to develop a highly dangerous novel threat vector (e.g., comparable to novel CDC Class A biological agent) OR model provides meaningfully improved assistance that enables anyone to be able to create a known CBRN threat OR model can be connected to tools and equipment to complete the full engineering and/or synthesis cycle of a regulated or novel CBRN threat without human intervention.", "paraphrase": "Critical CBRN risk means the model enables highly dangerous novel threats, universal access to known threats, or full automated engineering/synthesis of CBRN threats.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0077", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Critical / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Rationale for threshold", "excerpt": "The creation of a novel threat vector on the scale of a CDC Class A biological agent (i.e., high mortality, ease of transmission) could cause millions of deaths and significantly disrupt public life.", "paraphrase": "A CDC Class A-level novel threat could cause millions of deaths and major disruption.", "modal_register": "none", "stated_bar": "millions of deaths", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0078", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Critical / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Rationale for threshold", "excerpt": "Allowing anyone to create CBRN threats would maximally extend accessibility.", "paraphrase": "Universal accessibility of CBRN threat creation is the maximal extension of accessibility.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0079", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "CBRN (chemical, biological, radiological, nuclear)", "locator": "Table CBRN / Critical / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Critical; Column: Rationale for threshold", "excerpt": "Significantly automating the end-to-end engineering or synthesis cycle for a CBRN threat would also enable unprecedented and massive scale of potential attacks.", "paraphrase": "Automating the full CBRN engineering/synthesis cycle would enable unprecedented, massive-scale attacks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0080", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Persuasion", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Persuasion is focused on risks related to convincing people to change their beliefs (or act on) both static and interactive model-generated content.", "paraphrase": "Persuasion category covers risks of static and interactive model-generated content changing people's beliefs or actions.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0081", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Persuasion", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We define persuasive capability via the level of human persuasive content that can be commoditized by the model.", "paraphrase": "Persuasive capability is defined by the level of human persuasive content the model can commoditize.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0082", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Persuasion", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Typically, strong persuasion is rare and requires significant human effort (e.g., a 1:1 grassroots conversation, or a highly polished podcast); however, models could make all content up to their capability level nearly zero-cost to generate.", "paraphrase": "Strong persuasion normally requires significant human effort, but models could make such content nearly free to generate.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0083", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Persuasion", "locator": "Table Persuasion / Low / Definition", "unit_type": "table_cell", "context_stem": "Risk level: Low; Column: Definition", "excerpt": "Model can create (potentially interactive) content with comparable persuasive effectiveness to reading a low-quality article.", "paraphrase": "Low persuasion risk means model content is as persuasive as a low-quality article.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-2023-0084", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "NONE", "framework_year": 2023, "section_heading": "Persuasion", "locator": "Table Persuasion / Low / Rationale", "unit_type": "table_cell", "context_stem": "Risk level: Low; Column: Rationale for threshold", "excerpt": "Low-quality articles are very common and low-impact, so model commoditization has negligible impact.", "paraphrase": "Because low-quality articles are common and low-impact, model commoditization at this level has negligible impact.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
