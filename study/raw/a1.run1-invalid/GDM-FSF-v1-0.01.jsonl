{"unit_id": "GDM-FSF-v1-0-0028", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "3 - Applying mitigations", "locator": "3 / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The initial version of the Framework focuses on two categories of mitigations: security mitigations to prevent the exfiltration of model weights, and deployment mitigations (such as safety fine-tuning and misuse filtering, detection, and response) to manage access to and prevent the expression of critical capabilities in deployments.", "paraphrase": "This version focuses on two mitigation categories: security mitigations against weight exfiltration and deployment mitigations to manage/restrict expression of critical capabilities.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
