{"unit_id": "GDM-FSF-v1-0-0018", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "1 - Critical Capability Levels", "locator": "1 / para 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The Framework is built around capability thresholds called \"Critical Capability Levels.\" These are capability levels at which, absent mitigation measures, models may pose heightened risk.", "paraphrase": "The framework centers on capability thresholds, CCLs, at which unmitigated models could pose heightened risk.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0019", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "1 - Critical Capability Levels", "locator": "1 / para 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We determine CCLs by analyzing several high-risk domains: we identify the main paths through which a model could cause harm, and then define the CCLs as the minimal set of capabilities a model must possess to do so.", "paraphrase": "CCLs are derived by analyzing high-risk domains for harm pathways and defining minimal necessary capabilities.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
