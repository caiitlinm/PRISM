{"unit_id": "GDM-FSF-v1-0-0021", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "1 - Critical Capability Levels", "locator": "1 / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Our initial research indicates that powerful capabilities of future models seem most likely to pose risks in these domains. The CCLs we have identified are described below.", "paraphrase": "Initial research suggests these domains are most likely to present risks from powerful future model capabilities; the identified CCLs follow.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0022", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "2 - Evaluating frontier models", "locator": "2 / para 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The capabilities of frontier models are tested periodically to check whether they are approaching a CCL.", "paraphrase": "Frontier model capabilities are periodically tested to detect approach toward a CCL.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0023", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "2 - Evaluating frontier models", "locator": "2 / para 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "To do so, we will define a set of evaluations called \"early warning evaluations,\" with a specific \"pass\" condition that flags when a CCL may be reached before the evaluations are run again.", "paraphrase": "The lab will define early warning evaluations with pass conditions flagging potential CCL attainment before the next evaluation round.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0024", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "2 - Evaluating frontier models", "locator": "2 / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We are aiming to evaluate our models every 6x in effective compute and for every 3 months of fine-tuning progress.", "paraphrase": "The lab aims to evaluate models at every 6x increase in effective compute and every 3 months of fine-tuning progress.", "modal_register": "aspirational", "stated_bar": "6x effective compute; 3 months of fine-tuning", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0025", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "2 - Evaluating frontier models", "locator": "2 / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "To account for the gap between rounds of evaluation, we will design early warning evaluations to give us an adequate safety buffer before a model reaches a CCL.", "paraphrase": "Early warning evaluations will be designed with a safety buffer to account for gaps between evaluation rounds.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0026", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "3 - Applying mitigations", "locator": "3 / para 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "When a model reaches evaluation thresholds (i.e. passes a set of early warning evaluations), we will formulate a response plan based on the analysis of the CCL and evaluation results.", "paraphrase": "Reaching evaluation thresholds triggers formulation of a response plan based on CCL analysis and evaluation results.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
