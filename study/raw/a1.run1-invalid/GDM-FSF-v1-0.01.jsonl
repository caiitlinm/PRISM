{"unit_id": "GDM-FSF-v1-0-0031", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "3 - Applying mitigations", "locator": "3 / para 3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "If this happens, we would put on hold further deployment or development, or implement additional protocols (such as the implementation of more precise early warning evaluations for a given CCL) to ensure models will not reach CCLs without appropriate security mitigations, and that models with CCLs will not be deployed without appropriate deployment mitigations.", "paraphrase": "If mitigations lag behind, the lab would pause deployment/development or add protocols to ensure CCLs are not reached or deployed without appropriate mitigations.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
