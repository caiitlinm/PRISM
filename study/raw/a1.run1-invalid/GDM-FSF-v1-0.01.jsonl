{"unit_id": "GDM-FSF-v1-0-0061", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "Deployment Mitigations Table", "locator": "Deployment Table / Level 2 / Measures", "unit_type": "table_cell", "context_stem": "Row: 2: Safety case with red team validation. Column: Measures.", "excerpt": "A robustness target is set based on a safety case considering factors like the critical capability and deployment context. Afterwards, similar mitigations as Level 1 are applied, but deployment takes place only after the robustness of safeguards has been demonstrated to meet the target.", "paraphrase": "A safety-case-based robustness target is set, and deployment proceeds only after demonstrating that safeguards meet the target, using Level-1-like mitigations.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
