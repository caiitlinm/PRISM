{"unit_id": "GDM-FSF-v1-0-0066", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "Critical Capability Levels", "locator": "CCL / para 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Critical Capability Levels describe thresholds at which models may pose heightened risk without additional mitigation.", "paraphrase": "CCLs are thresholds at which unmitigated models could pose heightened risk.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "GDM-FSF-v1-0-0018", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0067", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "Critical Capability Levels", "locator": "CCL / para 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We will develop early warning evaluations to detect when models approach CCLs, and apply appropriate mitigations to models that reach evaluation thresholds.", "paraphrase": "Early warning evaluations will be developed to detect CCL approach, and mitigations will be applied when thresholds are reached.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0068", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "Footnote 6", "locator": "fn6", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "Note: when we refer to a model's capabilities, we include capabilities resulting from any reasonably foreseeable fine-tuning and scaffolding to turn the model into a functioning system.", "paraphrase": "This footnote clarifies that capability references include those from foreseeable fine-tuning and scaffolding.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0069", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "Critical Capability Levels", "locator": "CCL / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The table below details an initial set of CCLs we have identified through a preliminary analysis of the Autonomy, Biosecurity, Cybersecurity, and Machine Learning R&D risk domains.", "paraphrase": "A table presents the initial CCL set identified through preliminary analysis of four risk domains.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0070", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "Critical Capability Levels", "locator": "CCL / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "As we conduct further research into these and other risk domains, we expect these CCLs to evolve and for several CCLs at higher levels or in other risk domains to be added.", "paraphrase": "Further research is expected to lead the CCL set to evolve and expand into higher levels or new domains.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0071", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Autonomy / Critical capability level", "unit_type": "table_cell", "context_stem": "Row: Autonomy. Column: Critical capability level.", "excerpt": "Autonomy level 1: Capable of expanding its effective capacity in the world by autonomously acquiring resources and using them to run and sustain additional copies of itself on hardware it rents.", "paraphrase": "Autonomy level 1 is defined as autonomously acquiring resources to run and sustain additional copies of itself on rented hardware.", "modal_register": "none", "stated_bar": "Autonomy level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0072", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Autonomy / Risk domain", "unit_type": "table_cell", "context_stem": "Row: Autonomy. Column: Risk domain.", "excerpt": "Autonomy: Risks of the misuse of AI models with significant capacity for agency and flexible action/tool use over long time horizons and across many domains.", "paraphrase": "The Autonomy risk domain concerns misuse of AI with strong agency and flexible tool-use capacity across long horizons and domains.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0073", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Autonomy / Rationale", "unit_type": "table_cell", "context_stem": "Row: Autonomy. Column: Rationale.", "excerpt": "A model at this capability level could, if misused, pose difficult-to-predict and large-magnitude risks. Its adaptability would enable harmful activity via many means, and its ability to act autonomously and expand its effective capacity means its activity could be scaled significantly without being hindered by resource constraints.", "paraphrase": "The rationale states that a model at Autonomy level 1 could, if misused, cause unpredictable, large-scale harm since it can act autonomously and expand its capacity without resource constraints.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0074", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Autonomy / Rationale continued", "unit_type": "table_cell", "context_stem": "Row: Autonomy. Column: Rationale.", "excerpt": "If misused or supported by well-equipped bad actors, such activity may be especially difficult to constrain.", "paraphrase": "Misuse supported by capable bad actors may make this activity especially hard to constrain.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0075", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Biosecurity / Risk domain", "unit_type": "table_cell", "context_stem": "Row: Biosecurity. Column: Risk domain.", "excerpt": "Biosecurity: Risks of models assisting in the development, preparation and/or execution of a biological attack.", "paraphrase": "The Biosecurity domain covers risks of models aiding development, preparation, or execution of biological attacks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0076", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Biosecurity amateur / Critical capability level", "unit_type": "table_cell", "context_stem": "Row: Biosecurity (Bio amateur enablement level 1). Column: Critical capability level.", "excerpt": "Bio amateur enablement level 1: Capable of significantly enabling a non-expert to develop known biothreats that could increase their ability to cause severe harm compared to other means.", "paraphrase": "Bio amateur enablement level 1 means significantly enabling non-experts to develop known biothreats with greater harm capability than alternative means.", "modal_register": "none", "stated_bar": "Bio amateur enablement level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0077", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Biosecurity amateur / Rationale", "unit_type": "table_cell", "context_stem": "Row: Biosecurity (Bio amateur enablement level 1). Column: Rationale.", "excerpt": "Many biothreats capable of causing significant amounts of harm are currently out of the reach of non-experts because of lack of knowledge about their potential for harm and the methods of their acquisition and misuse.", "paraphrase": "Many harmful biothreats are currently inaccessible to non-experts due to knowledge gaps about harm potential and acquisition/misuse methods.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0078", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Biosecurity amateur / Rationale continued", "unit_type": "table_cell", "context_stem": "Row: Biosecurity (Bio amateur enablement level 1). Column: Rationale.", "excerpt": "An LLM that helps overcome these knowledge gaps, e.g. by suggesting plausible attack strategies or providing detailed instructions for the development of a bio agent, could significantly increase society's vulnerability to fatal attacks by malicious amateurs.", "paraphrase": "An LLM overcoming these knowledge gaps by suggesting attack strategies or bio agent instructions could greatly increase vulnerability to amateur-perpetrated fatal attacks.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0079", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Biosecurity expert / Critical capability level", "unit_type": "table_cell", "context_stem": "Row: Biosecurity (Bio expert enablement level 1). Column: Critical capability level.", "excerpt": "Bio expert enablement level 1: Capable of significantly enabling an expert (i.e. PhD or above) to develop novel biothreats that could result in an incident of high severity.", "paraphrase": "Bio expert enablement level 1 means significantly enabling PhD-level experts to develop novel biothreats capable of high-severity incidents.", "modal_register": "none", "stated_bar": "Bio expert enablement level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0080", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Biosecurity expert / Rationale", "unit_type": "table_cell", "context_stem": "Row: Biosecurity (Bio expert enablement level 1). Column: Rationale.", "excerpt": "A very small number of bio agents have the potential to cause harm of an exceptional magnitude.", "paraphrase": "Very few bio agents can cause exceptionally severe harm.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0081", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Biosecurity expert / Rationale continued", "unit_type": "table_cell", "context_stem": "Row: Biosecurity (Bio expert enablement level 1). Column: Rationale.", "excerpt": "The discovery of enhancements to these agents, or of agents of comparable harmfulness, could increase the chances of a very severe bio attack or accident.", "paraphrase": "Discovering enhancements to such agents, or comparably harmful agents, could raise chances of a severe bio attack or accident.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0082", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Cybersecurity / Risk domain", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity. Column: Risk domain.", "excerpt": "Cybersecurity: Risks of models assisting in the execution of a cyber attack.", "paraphrase": "The Cybersecurity domain covers risks of models assisting cyber attack execution.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0083", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Cyber autonomy / Critical capability level", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity (Cyber autonomy level 1). Column: Critical capability level.", "excerpt": "Cyber autonomy level 1: Capable of fully automating opportunistic cyberattacks on organizations with a limited security posture.", "paraphrase": "Cyber autonomy level 1 means fully automating opportunistic cyberattacks against weakly secured organizations.", "modal_register": "none", "stated_bar": "Cyber autonomy level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0084", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Cyber autonomy / Rationale", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity (Cyber autonomy level 1). Column: Rationale.", "excerpt": "Harmful cyberattacks against organizations with limited security posture can already be carried out by individuals with limited expertise, but the automation of such attacks would significantly lower the costs of doing so, and moreover would enable the execution of such attacks at scale.", "paraphrase": "Such attacks are already possible by low-expertise individuals, but automation would lower costs and enable execution at scale.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0085", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Cyber enablement / Critical capability level", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity (Cyber enablement level 1). Column: Critical capability level.", "excerpt": "Cyber enablement level 1: Capable of enabling an amateur to carry out sophisticated and severe attacks (e.g. those that disrupt critical national infrastructure).", "paraphrase": "Cyber enablement level 1 means enabling amateurs to execute sophisticated, severe attacks such as disrupting critical national infrastructure.", "modal_register": "none", "stated_bar": "Cyber enablement level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0086", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Cyber enablement / Rationale", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity (Cyber enablement level 1). Column: Rationale.", "excerpt": "Severe cyberattacks against high-impact targets currently require significant expertise and effort across the cyber kill-chain to carry out.", "paraphrase": "Severe attacks on high-impact targets currently demand significant expertise and effort across the cyber kill-chain.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v1-0-0087", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "CCL Table", "locator": "CCL Table / Cyber enablement / Rationale continued", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity (Cyber enablement level 1). Column: Rationale.", "excerpt": "Increasing text generation, programming, and tool-use capabilities in models, combined with improved understanding of cyber offense strategies, could help amateurs overcome difficult steps in the planning and execution of attacks.", "paraphrase": "Improved text generation, programming, tool-use, and cyber offense understanding could help amateurs overcome difficult attack planning/execution steps.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
