{"unit_id": "GDM-FSF-v1-0-0059", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 1.0", "framework_year": 2024, "section_heading": "Deployment Mitigations Table", "locator": "Deployment Table / Level 1 / Measures", "unit_type": "table_cell", "context_stem": "Row: 1: Mitigations targeting the critical capability. Column: Measures.", "excerpt": "Application, where appropriate, of the full suite of prevailing industry safeguards targeting the specific capability, including safety fine-tuning, misuse filtering and detection, and response protocols. Periodic red-teaming to assess the adequacy of mitigations.", "paraphrase": "Level 1 measures apply industry-standard safeguards targeting the specific capability and include periodic red-teaming to check mitigation adequacy.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
