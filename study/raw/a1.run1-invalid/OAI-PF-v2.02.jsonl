{"unit_id": "OAI-PF-v2-0151", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.1 Safeguard selection", "locator": "4.1 / bullet 2", "unit_type": "bullet", "context_stem": "We use the following process to select safeguards for a deployment:", "excerpt": "For each of those, we then identify specific safeguards that either exist or should be implemented that would address the risk.", "paraphrase": "For each identified risk pathway, existing or needed safeguards are identified.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0152", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.1 Safeguard selection", "locator": "4.1 / bullet 3", "unit_type": "bullet", "context_stem": "We use the following process to select safeguards for a deployment:", "excerpt": "For each identified safeguard, we identify methods to measure their efficacy and an efficacy threshold.", "paraphrase": "For each safeguard, measurement methods and an efficacy threshold are defined.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0153", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.1 Safeguard selection", "locator": "4.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We consider separate safeguards for two of the main ways in which risks can be realized: a malicious user, who can leverage the model to cause the severe harm, and a misaligned model, which autonomously causes the harm.", "paraphrase": "Safeguards are considered separately for malicious-user misuse and for autonomous harm from a misaligned model.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0154", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.1 Safeguard selection", "locator": "4.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We illustrate the types of safeguards for each in Table 3.", "paraphrase": "Table 3 illustrates the types of safeguards for each risk pathway.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
