{"unit_id": "OAI-PF-v2-0126", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.1 Evaluation approach", "locator": "3.1 / bullet 2", "unit_type": "bullet", "context_stem": "Capability evaluations come in two different forms:", "excerpt": "Deep Dives: designed to provide additional evidence validating the scalable evaluations’ findings on whether a capability threshold has been crossed. These may include a wide range of evidence gathering activities, such as human expert red-teaming, expert consultations, resource-intensive third party evaluations (e.g., bio wet lab studies, assessments by independent third party evaluators), and any other activity requested by SAG.", "paraphrase": "Deep Dives are supplementary evidence-gathering activities, such as red-teaming or third-party studies, that validate scalable evaluation findings.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0127", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.1 Evaluation approach", "locator": "callout / An example of a Tracked Category capability evaluation", "unit_type": "callout", "context_stem": "An example of a Tracked Category capability evaluation", "excerpt": "To assess the degree to which a covered system can reduce the barriers to creating a biological weapon, our current evaluations test both how capable the system is at providing useful information to someone creating a weapon and how capable it is of directly integrating with relevant tools, such as ordering precursor materials via the Internet.", "paraphrase": "An example evaluation assesses how much a system lowers barriers to bioweapon creation, including via useful information and tool integration like ordering precursors.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0128", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.1 Evaluation approach", "locator": "callout / An example of a Tracked Category capability evaluation", "unit_type": "callout", "context_stem": "An example of a Tracked Category capability evaluation", "excerpt": "Our evaluations test acquiring critical and sensitive information across the five stages of the biological threat creation process: Ideation, Acquisition, Magnification, Formulation, and Release. These evaluations, developed by domain experts, cover things like how to troubleshoot the laboratory processes involved.", "paraphrase": "Evaluations, developed by domain experts, test information acquisition across five biological threat creation stages, including troubleshooting lab processes.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0129", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.1 Evaluation approach", "locator": "callout / An example of a Tracked Category capability evaluation", "unit_type": "callout", "context_stem": "An example of a Tracked Category capability evaluation", "excerpt": "You can learn more about our Tracked Category capability evaluations in past system cards, such as those for OpenAI o1 and Operator.", "paraphrase": "Further detail on Tracked Category evaluations is available in past system cards, including for OpenAI o1 and Operator.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0130", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.2 Testing scope", "locator": "3.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The Preparedness Framework applies to any new or updated deployment that has a plausible chance of reaching a capability threshold whose corresponding risks are not addressed by an existing Safeguards Report.", "paraphrase": "The Framework covers any new or updated deployment plausibly reaching a capability threshold not already addressed by an existing Safeguards Report.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0131", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.2 Testing scope", "locator": "3.2 / bullet 1", "unit_type": "bullet", "context_stem": "Examples of such covered deployments are:", "excerpt": "every frontier model (e.g., OpenAI o1 or OpenAI o3) that we plan to deploy externally", "paraphrase": "Any frontier model planned for external deployment is a covered deployment.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0132", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.2 Testing scope", "locator": "3.2 / bullet 2", "unit_type": "bullet", "context_stem": "Examples of such covered deployments are:", "excerpt": "any agentic system (including significant agents deployed only internally) that represents a substantial increase in the capability frontier", "paraphrase": "Agentic systems, even internal-only ones, that substantially increase the capability frontier are covered.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0133", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.2 Testing scope", "locator": "3.2 / bullet 3", "unit_type": "bullet", "context_stem": "Examples of such covered deployments are:", "excerpt": "any significant change in the deployment conditions of an existing model (e.g., enabling finetuning, releasing weights, or significant new features) that makes the existing Capabilities Report or Safeguards Report no longer reasonably applicable", "paraphrase": "Significant changes to deployment conditions that invalidate an existing Capabilities or Safeguards Report are covered.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0134", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.2 Testing scope", "locator": "3.2 / bullet 4", "unit_type": "bullet", "context_stem": "Examples of such covered deployments are:", "excerpt": "incremental updates or distilled models with unexpectedly significant increases in capability.", "paraphrase": "Incremental updates or distilled models showing unexpectedly large capability gains are covered.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0135", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.2 Testing scope", "locator": "fn6", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "In general, models that we distill, fine-tune, or quantize from a model that was previously determined not to cross a High capability threshold will ordinarily not require additional safety measures barring reason to believe a significant increase in capability has occurred.", "paraphrase": "Models derived via distillation, finetuning, or quantization from a sub-High model normally do not need additional safeguards absent evidence of a significant capability increase.", "modal_register": "conditional", "stated_bar": "High", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0136", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.2 Testing scope", "locator": "3.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "If justified by our forecasts and threat models as potentially posing a severe risk during development and prior to external deployment, we will select an appropriate checkpoint during development to be covered by the Preparedness Framework.", "paraphrase": "If forecasts and threat models suggest severe risk before external deployment, an appropriate development checkpoint will be selected for coverage under the Framework.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0137", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.2 Testing scope", "locator": "3.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In cases of ambiguity about whether a model is covered by the Preparedness Framework, the SAG is responsible for making the final determination.", "paraphrase": "The SAG has final authority to resolve ambiguity about Framework coverage.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0138", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "3.3 Capability threshold determinations", "locator": "3.3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Prior to deployment, every covered model undergoes the suite of Scalable Evaluations.", "paraphrase": "All covered models must pass through Scalable Evaluations before deployment.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
