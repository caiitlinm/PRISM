{"unit_id": "OAI-PF-v2-0164", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Many safeguards can be reused across different deployments, and so in practice we may find that the majority of deployments need few new safeguards and associated stress-testing beyond those already in place for prior deployments.", "paraphrase": "Because safeguards are often reusable, most deployments may need little new safeguard work beyond what already exists.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0165", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "SAG is responsible for assessing whether the safeguards associated with a given deployment sufficiently minimize the risk of severe harm associated with the proposed deployment.", "paraphrase": "The SAG assesses whether a deployment's safeguards sufficiently minimize severe harm risk.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0166", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The SAG will make this determination based on:", "paraphrase": "SAG's determination will rest on certain listed factors.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0167", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2 / bullet 1", "unit_type": "bullet", "context_stem": "The SAG will make this determination based on:", "excerpt": "The level of capability in the Tracked Category based on the Capabilities Report.", "paraphrase": "One factor is the capability level in the Tracked Category per the Capabilities Report.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0168", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2 / bullet 2", "unit_type": "bullet", "context_stem": "The SAG will make this determination based on:", "excerpt": "The associated risks of severe harm, as described in the threat model and where needed, advice of internal or external experts.", "paraphrase": "Another factor is risk of severe harm per the threat model and, if needed, expert advice.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0169", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 3: Types of safeguards", "locator": "Table 3 / Safeguards Against Malicious Users / Robustness", "unit_type": "table_cell", "context_stem": "Column: Safeguards Against Malicious Users; Item: Robustness", "excerpt": "Malicious users cannot use the model to cause the severe harm because they cannot elicit the necessary capability, such as because the model is modified to refuse to provide assistance to harmful tasks and is robust to jailbreaks that would circumvent those refusals.", "paraphrase": "Robustness claim: malicious users cannot elicit harmful capability because the model refuses harmful tasks and resists jailbreaks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0170", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 3: Types of safeguards", "locator": "Table 3 / Safeguards Against Malicious Users / Usage Monitoring", "unit_type": "table_cell", "context_stem": "Column: Safeguards Against Malicious Users; Item: Usage Monitoring", "excerpt": "If a model does not refuse and provides assistance to harmful tasks, monitors can stop or catch malicious users before they have achieved an unacceptable scale of harm, through a combination of automated and human detection and enforcement within an acceptable time frame.", "paraphrase": "Usage Monitoring claim: if the model assists harmful tasks, monitoring can catch users before unacceptable harm scale is reached, using automated and human detection within an acceptable time.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0171", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 3: Types of safeguards", "locator": "Table 3 / Safeguards Against Malicious Users / Trust-based Access", "unit_type": "table_cell", "context_stem": "Column: Safeguards Against Malicious Users; Item: Trust-based Access", "excerpt": "The actors who gain access to the model are not going to use it in a way that presents an associated risk of severe harm under our threat model.", "paraphrase": "Trust-based Access claim: actors granted access are not expected to misuse the model to create severe harm risk.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0172", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 3: Types of safeguards", "locator": "Table 3 / Safeguards Against a Misaligned Model / Lack of Autonomous Capability", "unit_type": "table_cell", "context_stem": "Column: Safeguards Against a Misaligned Model; Item: Lack of Autonomous Capability", "excerpt": "The model is not capable of carrying out tasks autonomously, including the risk of severe harm.", "paraphrase": "Lack of Autonomous Capability claim: the model cannot autonomously carry out tasks, including causing severe harm.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0173", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 3: Types of safeguards", "locator": "Table 3 / Safeguards Against a Misaligned Model / Value Alignment", "unit_type": "table_cell", "context_stem": "Column: Safeguards Against a Misaligned Model; Item: Value Alignment", "excerpt": "The model consistently applies human values in novel settings (without any instructions) to avoid taking actions that cause harm, and has shown sufficiently minimal indications of misaligned behaviors like deception or scheming.", "paraphrase": "Value Alignment claim: the model applies human values in novel settings without instructions to avoid harm, showing minimal deception or scheming.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0174", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 3: Types of safeguards", "locator": "Table 3 / Safeguards Against a Misaligned Model / Instruction Alignment", "unit_type": "table_cell", "context_stem": "Column: Safeguards Against a Misaligned Model; Item: Instruction Alignment", "excerpt": "The model consistently understands and follows user or system instructions, even when vague, and those instructions rule out pathways to causing severe harm.", "paraphrase": "Instruction Alignment claim: the model reliably follows instructions, even vague ones, that rule out severe harm pathways.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0175", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 3: Types of safeguards", "locator": "Table 3 / Safeguards Against a Misaligned Model / Reliable and Robust System Oversight", "unit_type": "table_cell", "context_stem": "Column: Safeguards Against a Misaligned Model; Item: Reliable and Robust System Oversight", "excerpt": "Effective AI and human oversight of model actions detects and prevents execution of harm or subversion of safeguards.", "paraphrase": "System Oversight claim: effective AI and human oversight detects and prevents harmful actions or safeguard subversion.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0176", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 3: Types of safeguards", "locator": "Table 3 / Safeguards Against a Misaligned Model / System Architecture", "unit_type": "table_cell", "context_stem": "Column: Safeguards Against a Misaligned Model; Item: System Architecture", "excerpt": "The model can’t take actions that cause harm because it lacks access to output channels or mechanisms to persist sufficiently to execute the harm, due to system design and restricted permissions.", "paraphrase": "System Architecture claim: the model cannot cause harm due to lack of output channels or persistence mechanisms, by design.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0177", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2 / bullet 3", "unit_type": "bullet", "context_stem": "The SAG will make this determination based on:", "excerpt": "The safeguards in place and their effectiveness based on the Safeguards Report.", "paraphrase": "Another determining factor is existing safeguards and their effectiveness per the Safeguards Report.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0178", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2 / bullet 4", "unit_type": "bullet", "context_stem": "The SAG will make this determination based on:", "excerpt": "The baseline risk from other deployments, based on a review of any non-OpenAI deployments of models which have crossed the capability thresholds and any public evidence of the safeguards applied for those models.", "paraphrase": "A further factor is baseline risk from other deployments, based on reviewing non-OpenAI models that crossed thresholds and any public safeguard evidence for them.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0179", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Covered systems that reach High capability must have safeguards that sufficiently minimize the associated risk of severe harm before they are deployed.", "paraphrase": "High-capability systems must have sufficient safeguards before deployment.", "modal_register": "mandatory", "stated_bar": "High", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0180", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Systems that reach Critical capability also require safeguards that sufficiently minimize associated risks during development.", "paraphrase": "Critical-capability systems must have sufficient safeguards during development too.", "modal_register": "mandatory", "stated_bar": "Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0181", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Based on this evidence, SAG then has the following decision points:", "paraphrase": "SAG has several possible decision points based on the evidence.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0182", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2 / numbered 1", "unit_type": "numbered", "context_stem": "SAG then has the following decision points:", "excerpt": "SAG can find that it is confident that the safeguards sufficiently minimize the associated risk of severe harm for the proposed deployment, and recommend deployment.", "paraphrase": "SAG may find safeguards sufficient and recommend deployment.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0183", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2 / numbered 2", "unit_type": "numbered", "context_stem": "SAG then has the following decision points:", "excerpt": "SAG can request further evaluation of the effectiveness of the safeguards to evaluate if the associated risk of severe harm is sufficiently minimized", "paraphrase": "SAG may request further safeguard evaluation to confirm sufficiency.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0184", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2 / numbered 3", "unit_type": "numbered", "context_stem": "SAG then has the following decision points:", "excerpt": "SAG can find the safeguards do not sufficiently minimize the risk of severe harm and recommend potential alternative deployment conditions or additional or more effective safeguards that would sufficiently minimize the risk.", "paraphrase": "SAG may find safeguards insufficient and recommend alternative conditions or stronger safeguards.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0185", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The SAG will strive to recommend further actions that are as targeted and non-disruptive as possible while still mitigating risks of severe harm.", "paraphrase": "SAG aims for recommendations that are targeted and minimally disruptive while still mitigating severe harm risk.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0186", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "All of SAG’s recommendations will go to OpenAI Leadership for final decision-making in accordance with the decision-making practices outlined in Appendix B.", "paraphrase": "SAG recommendations go to OpenAI Leadership for final decisions per Appendix B practices.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0187", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We expect to continuously improve our safeguards over time.", "paraphrase": "OpenAI expects to keep improving its safeguards over time.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0188", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.2 Safeguard sufficiency", "locator": "4.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "If we find reasonable evidence that our safeguards are not working as expected, we will validate the information being received and review the sufficiency of our safeguards.", "paraphrase": "If evidence suggests safeguards are underperforming, the information will be validated and safeguard sufficiency reviewed.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0189", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.3 Marginal risk", "locator": "4.3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We recognize that another frontier AI model developer might develop or release a system with High or Critical capability in one of this Framework’s Tracked Categories and may do so without instituting comparable safeguards to the ones we have committed to.", "paraphrase": "OpenAI acknowledges another developer might release a High or Critical capability system without comparable safeguards.", "modal_register": "conditional", "stated_bar": "High, Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0190", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.3 Marginal risk", "locator": "4.3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Such an action could significantly increase the baseline risk of severe harm being realized in the world, and limit the degree to which we can reduce risk using our safeguards.", "paraphrase": "Such action by another developer could raise baseline severe harm risk and limit OpenAI's own risk-reduction ability.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0191", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.3 Marginal risk", "locator": "4.3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "If we are able to rigorously confirm that such a scenario has occurred, then we could adjust accordingly the level of safeguards that we require in that capability area, but only if:", "paraphrase": "If such a scenario is rigorously confirmed, OpenAI could adjust required safeguard levels for that capability area, subject to conditions.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0192", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.3 Marginal risk", "locator": "4.3 / bullet 1", "unit_type": "bullet", "context_stem": "we could adjust accordingly the level of safeguards that we require in that capability area, but only if:", "excerpt": "we assess that doing so does not meaningfully increase the overall risk of severe harm,", "paraphrase": "Condition: the adjustment must not meaningfully increase overall severe harm risk.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0193", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.3 Marginal risk", "locator": "4.3 / bullet 2", "unit_type": "bullet", "context_stem": "we could adjust accordingly the level of safeguards that we require in that capability area, but only if:", "excerpt": "we publicly acknowledge that we are making the adjustment,", "paraphrase": "Condition: the adjustment must be publicly acknowledged.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0194", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.3 Marginal risk", "locator": "4.3 / bullet 3", "unit_type": "bullet", "context_stem": "we could adjust accordingly the level of safeguards that we require in that capability area, but only if:", "excerpt": "and, in order to avoid a race to the bottom on safety, we keep our safeguards at a level more protective than the other AI developer, and share information to validate this claim.", "paraphrase": "Condition: safeguards must remain more protective than the other developer's, with information shared to validate this, to avoid a race to the bottom.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0195", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.4 Increasing safeguards before internal use and further development", "locator": "4.4", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Models that have reached or are forecasted to reach Critical capability in a Tracked Category present severe dangers and should be treated with extreme caution.", "paraphrase": "Models reaching or forecasted to reach Critical capability present severe dangers requiring extreme caution.", "modal_register": "aspirational", "stated_bar": "Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0196", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.4 Increasing safeguards before internal use and further development", "locator": "4.4", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Such models require additional safeguards (safety and security controls) during development, regardless of whether or when they are externally deployed.", "paraphrase": "Critical-capability models require extra safety and security controls during development regardless of external deployment timing.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0197", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.4 Increasing safeguards before internal use and further development", "locator": "4.4", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We do not currently possess any models that have Critical levels of capability, and we expect to further update this Preparedness Framework before reaching such a level with any model.", "paraphrase": "OpenAI has no current Critical-capability models and expects to update the Framework before reaching that level.", "modal_register": "aspirational", "stated_bar": "Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0198", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.4 Increasing safeguards before internal use and further development", "locator": "4.4", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Our approach to Critical capabilities will need to be robust to both malicious actors (either internal or external) and model misalignment risks.", "paraphrase": "The approach to Critical capabilities must address both malicious actor threats and model misalignment risks.", "modal_register": "mandatory", "stated_bar": "Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0199", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "4.4 Increasing safeguards before internal use and further development", "locator": "4.4", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The SAG retains discretion over when to request deep dive evaluations of models whose scalable evaluations indicate that they may possess or may be nearing critical capability thresholds.", "paraphrase": "SAG has discretion to request deep dive evaluations for models nearing or possibly possessing critical capability, based on scalable evaluation indications.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}