{"unit_id": "GDM-FSF-v2-0-0088", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / Cyber uplift / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Cyber: Risks of models assisting in the execution of a cyber attack. Sub-row: Cyber uplift level 1. Column: Recommended security level and rationale.", "excerpt": "A model at this capability level could help fairly well-resourced threat actors carry out severe cyber attacks on targets like critical businesses, national government entities, and critical national infrastructure with lower resource expenditure, potentially increasing the frequency of such attacks significantly.", "paraphrase": "This capability could help well-resourced actors carry out severe attacks on critical targets more cheaply, increasing attack frequency significantly.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0089", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / Cyber uplift / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Cyber: Risks of models assisting in the execution of a cyber attack. Sub-row: Cyber uplift level 1. Column: Recommended security level and rationale.", "excerpt": "However, as above, cyber defense may improve to diminish the impact of AI-assisted cyber attacks. Similarly, the ambiguous net costs of exfiltration count against security levels with higher costs to innovation.", "paraphrase": "Cyber defense may improve to offset impacts, and ambiguous exfiltration costs argue against higher-cost security levels.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0090", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D uplift / Critical capability level", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D: Risks of the misuse of models capable of accelerating the rate of AI progress. Sub-row: Machine Learning R&D uplift level 1.", "excerpt": "Machine Learning R&D uplift level 1: Can or has been used to accelerate AI development, resulting in AI progress substantially accelerating (e.g. 2x) from 2020-2024 rates.", "paraphrase": "ML R&D uplift level 1 is defined as substantially accelerating AI progress, e.g. doubling the 2020-2024 rate.", "modal_register": "none", "stated_bar": "2x from 2020-2024 rates", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0091", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D uplift / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D uplift level 1. Column: Recommended security level and rationale.", "excerpt": "Security controls and detections at a level generally aligned with RAND SL 3", "paraphrase": "The recommended security level for ML R&D uplift level 1 is RAND SL 3.", "modal_register": "none", "stated_bar": "RAND SL 3", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0092", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D uplift / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D uplift level 1. Column: Recommended security level and rationale.", "excerpt": "Unrestricted access to models at this level of capability could significantly increase an actor's ability to progress to yet more powerful models and other critical capabilities.", "paraphrase": "Unrestricted access at this level could significantly boost an actor's ability to reach even more powerful capabilities.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0093", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D uplift / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D uplift level 1. Column: Recommended security level and rationale.", "excerpt": "The exfiltration of such a model may therefore have a significant effect on society's ability to adapt to and govern powerful AI systems, effects that may have long-lasting consequences. Substantially strengthened security is therefore recommended.", "paraphrase": "Exfiltration at this level could significantly and lastingly affect societal governance of AI, warranting substantially strengthened security.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0094", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D autonomy / Critical capability level", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D. Sub-row: Machine Learning R&D autonomy level 1.", "excerpt": "Machine Learning R&D autonomy level 1: Can fully automate the AI R&D pipeline at a competitive cost. The cost comparison is relative to humans augmented by AI tools.", "paraphrase": "ML R&D autonomy level 1 is defined as fully automating the AI R&D pipeline at a cost competitive with AI-augmented humans.", "modal_register": "none", "stated_bar": "ML R&D autonomy level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0095", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D autonomy / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D autonomy level 1. Column: Recommended security level and rationale.", "excerpt": "We recommend security controls and detections at a level generally aligned with RAND SL 4 for this capability threshold, but emphasize that this must be taken on by the frontier AI field as a whole.", "paraphrase": "RAND SL 4-aligned security is recommended for this threshold, emphasized as a field-wide responsibility.", "modal_register": "mandatory", "stated_bar": "RAND SL 4", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0096", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D autonomy / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D autonomy level 1. Column: Recommended security level and rationale.", "excerpt": "Unrestricted access to models at this level of capability could give an actor with adequate computational resources the ability to reach capabilities much more powerful than those in the other CCLs listed in a short amount of time.", "paraphrase": "Unrestricted access could let a well-resourced actor rapidly reach far more powerful capabilities than other listed CCLs.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0097", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D autonomy / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D autonomy level 1. Column: Recommended security level and rationale.", "excerpt": "This could be catastrophic if there is no effective way of defending against rapidly improving and potentially superhuman AI systems wielded by threat actors.", "paraphrase": "This scenario could be catastrophic absent effective defenses against rapidly improving superhuman AI wielded by threat actors.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0098", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 1: Misuse CCLs and Security Mitigations", "locator": "Table 1 / ML R&D autonomy / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: Machine Learning R&D autonomy level 1. Column: Recommended security level and rationale.", "excerpt": "Therefore, we recommend models at this level of capability have exceptional security even though they may have substantial innovation costs.", "paraphrase": "Exceptional security is recommended for this capability level despite substantial innovation costs.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0099", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Deceptive Alignment", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This section describes an initial approach for addressing risks of deceptive alignment.", "paraphrase": "This section introduces an initial approach to deceptive alignment risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0100", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Deceptive Alignment", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "By \"deceptive alignment,\" we mean the risk that AI systems purposefully undermine human control over AI systems.", "paraphrase": "Deceptive alignment is defined as AI systems purposefully undermining human control.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "GDM-FSF-v2-0-0023", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0101", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Deceptive Alignment", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "While we do not express any opinion here about how likely it is for deceptive alignment to arise, this section's provisions aim to prepare for this possibility.", "paraphrase": "No opinion is given on the likelihood of deceptive alignment, but this section aims to prepare for it.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0102", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Deceptive Alignment", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Note that the effective mitigation of deceptive alignment risk requires the application of safeguards to all AI systems reaching critical capabilities.", "paraphrase": "Effective mitigation of deceptive alignment requires safeguards on all AI systems reaching critical capabilities.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0103", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Deceptive Alignment", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "It is important that the industry adopts strategies for addressing this risk: what is detailed in this section represents one possible approach for doing so.", "paraphrase": "Industry-wide adoption of strategies is important; this section presents one possible approach.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0104", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Mitigation Approach and Critical Capability Levels", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "An initial mitigation approach focuses on detecting when models might develop a baseline instrumental reasoning ability at which they have the potential to undermine human control, assuming no additional mitigations were applied.", "paraphrase": "The initial approach focuses on detecting baseline instrumental reasoning ability that could undermine human control absent mitigations.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0105", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Mitigation Approach and Critical Capability Levels", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "When models reach this capability level, we believe applying an automated monitor to the model's explicit reasoning (e.g. chain-of-thought output) is an effective mitigation.", "paraphrase": "At this capability level, applying automated monitoring to explicit reasoning output is believed to be an effective mitigation.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0106", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Mitigation Approach and Critical Capability Levels", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Once a model is capable of effective instrumental reasoning in ways that cannot be monitored, additional mitigations may be warranted—the development of which is an area of active research.", "paraphrase": "Once instrumental reasoning cannot be monitored, additional mitigations, still under active research, may be needed.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0107", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 2: Deceptive Alignment CCLs and Mitigations", "locator": "Table 2 / Instrumental Reasoning Level 1 / CCL description", "unit_type": "table_cell", "context_stem": "Row label: Instrumental Reasoning Level 1.", "excerpt": "the instrumental reasoning abilities of the model enable enough situational awareness (ability to work out and use relevant details of its deployment setting) and stealth (ability to circumvent basic oversight mechanisms) such that, absent additional mitigations, we cannot rule out the model significantly undermining human control.", "paraphrase": "Instrumental Reasoning Level 1 is defined by sufficient situational awareness and stealth that, absent mitigations, undermining human control cannot be ruled out.", "modal_register": "none", "stated_bar": "Instrumental Reasoning Level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0108", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 2: Deceptive Alignment CCLs and Mitigations", "locator": "Table 2 / Instrumental Reasoning Level 1 / Mitigation", "unit_type": "table_cell", "context_stem": "Row label: Instrumental Reasoning Level 1. Column: Mitigation.", "excerpt": "Automated monitoring: a monitoring system to detect illicit use of instrumental reasoning capabilities in a model's chain-of-thought and use it in high-stakes deployments where there is significant risk of the model undermining human control.", "paraphrase": "The mitigation is automated monitoring of chain-of-thought to detect illicit reasoning use in high-stakes deployments with significant undermining risk.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0109", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 2: Deceptive Alignment CCLs and Mitigations", "locator": "Table 2 / Instrumental Reasoning Level 2 / CCL description", "unit_type": "table_cell", "context_stem": "Row label: Instrumental Reasoning Level 2.", "excerpt": "the instrumental reasoning abilities of the model enable enough situational awareness and stealth that, even when relevant model outputs (including, e.g., scratchpads) are being monitored, we cannot detect or rule out the risk of a model significantly undermining human control.", "paraphrase": "Instrumental Reasoning Level 2 is defined by capabilities such that even monitored outputs cannot rule out significant undermining of human control.", "modal_register": "none", "stated_bar": "Instrumental Reasoning Level 2", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0110", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Table 2: Deceptive Alignment CCLs and Mitigations", "locator": "Table 2 / Instrumental Reasoning Level 2 / Mitigation", "unit_type": "table_cell", "context_stem": "Row label: Instrumental Reasoning Level 2. Column: Mitigation.", "excerpt": "Future work: We are actively researching approaches to addressing models that reach this CCL.", "paraphrase": "For this CCL, mitigation approaches are still under active research.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
