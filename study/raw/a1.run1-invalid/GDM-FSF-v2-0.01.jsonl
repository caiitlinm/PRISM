{"unit_id": "GDM-FSF-v2-0-0117", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Safety Cases and Control Evaluations", "locator": "numbered 2", "unit_type": "numbered", "context_stem": "The approach above relies on two safety cases centering respectively on the claims that:", "excerpt": "An automated monitoring process that is validated by a control evaluation is adequate for catching the model's malicious behavior.", "paraphrase": "The second safety case claims a control-evaluation-validated automated monitoring process is adequate to catch malicious behavior.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0118", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Safety Cases and Control Evaluations", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Once neither of these apply, that is, once automated monitoring is no longer adequate/can no longer pass a control evaluation, a model is deemed to have reached the second CCL.", "paraphrase": "A model is deemed to have reached the second CCL once automated monitoring is no longer adequate or fails a control evaluation.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0119", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Governance", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "For Google models, when alert thresholds are reached, the response plan will be reviewed and approved by appropriate corporate governance bodies such as the Google DeepMind AGI Safety Council, Google DeepMind Responsibility and Safety Council, and/or Google Trust & Compliance Council.", "paraphrase": "Response plans, once alert thresholds are reached, will be reviewed and approved by named corporate governance bodies.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0120", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Governance", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The Google DeepMind AGI Safety Council will periodically review the implementation of the Framework.", "paraphrase": "The AGI Safety Council will periodically review how the Framework is implemented.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0121", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Disclosure", "locator": "N/A", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "If we assess that a model has reached a CCL that poses an unmitigated and material risk to overall public safety, we aim to share information with appropriate government authorities where it will facilitate the development of safe AI.", "paraphrase": "If a model reaches a CCL posing unmitigated material risk to public safety, Google aims to share information with relevant government authorities to support safe AI development.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
