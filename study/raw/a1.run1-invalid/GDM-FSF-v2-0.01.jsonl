{"unit_id": "GDM-FSF-v2-0-0131", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Future Work", "locator": "bullet 1", "unit_type": "bullet", "context_stem": "Issues that we aim to address in future versions of the Framework include:", "excerpt": "Greater precision in risk modeling: While we have updated our CCLs and underlying threat models from version 1.0, there remains significant room for improvement in understanding the risks posed by models in different domains, and refining our set of CCLs.", "paraphrase": "One future-work issue is greater precision in risk modeling, since CCLs and threat models still need refinement despite updates from version 1.0.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0132", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Future Work", "locator": "bullet 2", "unit_type": "bullet", "context_stem": "Issues that we aim to address in future versions of the Framework include:", "excerpt": "Capability elicitation: Our evaluators continue to improve their ability to estimate what capabilities may be attainable by different threat actors with access to our models, taking into account a growing number of possible post-training enhancements.", "paraphrase": "Another future-work issue is improving estimates of attainable capabilities for threat actors, accounting for post-training enhancements.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0133", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Future Work", "locator": "bullet 3", "unit_type": "bullet", "context_stem": "Issues that we aim to address in future versions of the Framework include:", "excerpt": "Updated set of risks and mitigations: There may be additional risk domains and critical capabilities that fall into scope as AI capabilities improve and the external environment changes.", "paraphrase": "Another issue is that additional risk domains and capabilities may fall into scope as AI and the environment change.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0134", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Future Work", "locator": "bullet 3", "unit_type": "bullet", "context_stem": "Issues that we aim to address in future versions of the Framework include:", "excerpt": "Future work will aim to include additional pressing risks, which may include additional risk domains or higher CCLs within existing domains.", "paraphrase": "Future work aims to add pressing risks, potentially including new risk domains or higher CCLs in existing domains.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0135", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Future Work", "locator": "bullet 4", "unit_type": "bullet", "context_stem": "Issues that we aim to address in future versions of the Framework include:", "excerpt": "Deceptive alignment approach beyond automated monitoring: We are actively researching approaches to addressing models that reach the \"Instrumental Reasoning Level 2\" CCL.", "paraphrase": "Another issue is developing a deceptive alignment approach beyond automated monitoring, currently under active research for Instrumental Reasoning Level 2.", "modal_register": "aspirational", "stated_bar": "Instrumental Reasoning Level 2", "duplicate_of": "GDM-FSF-v2-0-0110", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v2-0-0136", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 2.0", "framework_year": 2025, "section_heading": "Future Work", "locator": "bullet 5", "unit_type": "bullet", "context_stem": "Issues that we aim to address in future versions of the Framework include:", "excerpt": "Broader approach to ML R&D risks: The risks posed by models reaching our ML R&D CCLs may require measures beyond security and deployment mitigations, to ensure that safety measures and social institutions continue to be able to adapt to new AI capabilities amidst possible acceleration in AI development.", "paraphrase": "ML R&D CCL risks may need measures beyond security and deployment mitigations to keep safety measures and institutions adaptive amid AI acceleration.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
