{"unit_id": "OAI-PF-v2-0289", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.2 Safeguards against a misaligned model", "locator": "C.2 / paragraph 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "In addition to human misuse, several of the Tracked Category capabilities pose risks when models themselves are able to autonomously execute a severe harm, whether due to misalignment or subversion by an adversary.", "paraphrase": "Beyond misuse, tracked capabilities risk autonomous severe harm execution by models due to misalignment or adversarial subversion.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
