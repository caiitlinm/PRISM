{"unit_id": "OAI-PF-v2-0338", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Defense in Depth / sub-bullet 2", "unit_type": "bullet", "context_stem": "Zero Trust Principles", "excerpt": "Leverage hardware-backed security and modern authentication standards and controls for accessing critical resources and performing operations.", "paraphrase": "Hardware-backed security and modern authentication standards should be leveraged for accessing critical resources and performing operations.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
