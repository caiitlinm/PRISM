{"unit_id": "OAI-PF-v2-0340", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Access Management / sub-bullet 1", "unit_type": "bullet", "context_stem": "Principle of Least Privilege", "excerpt": "Ensure all access is regularly audited and reviewed.", "paraphrase": "All access must be regularly audited and reviewed.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
