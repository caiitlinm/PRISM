{"unit_id": "OAI-PF-v2-0324", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / paragraph 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Robust security practices and controls are essential to mitigating risks associated with the deployment of models reaching High capability thresholds.", "paraphrase": "Robust security practices are essential for mitigating risks of deploying models at High capability thresholds.", "modal_register": "none", "stated_bar": "High", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
