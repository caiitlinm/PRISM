{"unit_id": "OAI-PF-v2-0224", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 6", "unit_type": "numbered", "context_stem": "Key changes include that we:", "excerpt": "Provide more detail on our capability elicitation approach, making clear that we will consider a range of techniques in order to test a model version that approximates the high end of expected elicitation by threat actors attempting to misuse the model.", "paraphrase": "Additional detail is given on elicitation methods, clarifying that testing will approximate the high end of expected threat-actor elicitation.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0225", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 6", "unit_type": "numbered", "context_stem": "Provide more detail on our capability elicitation approach.", "excerpt": "We also define \"scalable evaluations,\" which are automated, and distinguish these from \"deep dive\" evaluations that may include consultation with human experts and are designed in part to validate the scalable evaluations.", "paraphrase": "The document defines automated 'scalable evaluations' distinct from 'deep dive' evaluations involving human expert consultation to validate scalable evaluations.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0226", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 7", "unit_type": "numbered", "context_stem": "Key changes include that we:", "excerpt": "Provide risk-specific safeguard guidelines. This information gives more detail on how we expect to safely develop and deploy models advanced enough to pose severe risks in tracked capability areas.", "paraphrase": "Risk-specific safeguard guidelines detail expectations for safely developing and deploying models capable of severe risks.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0227", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 7", "unit_type": "numbered", "context_stem": "Provide risk-specific safeguard guidelines.", "excerpt": "As we move toward increasingly capable models, we are planning for safeguards that will be tailored to the specific risks they are intended to address.", "paraphrase": "Future safeguards will be tailored to the specific risks of increasingly capable models.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0228", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 8", "unit_type": "numbered", "context_stem": "Key changes include that we:", "excerpt": "Establish Capabilities Reports and Safeguards Reports, the key artifacts we use to support informed decision-making under the Preparedness Framework in the context of systems that are capable enough to pose severe risks.", "paraphrase": "Capabilities Reports and Safeguards Reports are established as key decision-making artifacts for systems that could pose severe risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0229", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 9", "unit_type": "numbered", "context_stem": "Key changes include that we:", "excerpt": "Clarify approach to establishing safeguard efficacy, moving beyond the flawed approach of re-running capability evaluations on the safeguarded model and towards a more thorough assessment of each safeguard and its efficacy (Section 4.1).", "paraphrase": "The approach to establishing safeguard efficacy is clarified, moving away from re-running evaluations toward a thorough per-safeguard assessment.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0230", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 10", "unit_type": "numbered", "context_stem": "Key changes include that we:", "excerpt": "Deprioritize safety drills, as we are shifting our attention to a more durable approach of continuously red-teaming and assessing the effectiveness of our safeguards.", "paraphrase": "Safety drills are deprioritized in favor of continuous red-teaming and ongoing safeguard-effectiveness assessment.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0231", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 11", "unit_type": "numbered", "context_stem": "Key changes include that we:", "excerpt": "Clarify our focus on marginal risk, including the context of other systems available on the market, and outline our approach for maintaining responsible safeguards and reinforcing responsible practices across the industry if another actor releases a system we would assess as having High or Critical capability.", "paraphrase": "The framework clarifies a marginal-risk focus considering other market systems, and outlines the response approach if another actor releases a High or Critical capability system.", "modal_register": "none", "stated_bar": "High or Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0232", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 12", "unit_type": "numbered", "context_stem": "Key changes include that we:", "excerpt": "Clarify the governance process. Our Safety Advisory Group oversees the effective design, implementation, and adherence to the Preparedness Framework, in partnership with safety leaders in the company.", "paraphrase": "The governance process is clarified: the Safety Advisory Group oversees framework design, implementation, and adherence with company safety leaders.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0233", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "A Change log", "locator": "App A / item 12", "unit_type": "numbered", "context_stem": "Clarify the governance process.", "excerpt": "For covered launches, SAG assesses residual risk in tracked areas, net of safeguards, and makes expert recommendations on safeguard adequacy and deployment decision-making to OpenAI leadership.", "paraphrase": "For covered launches, SAG evaluates residual risk after safeguards and recommends on safeguard adequacy and deployment decisions to leadership.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
