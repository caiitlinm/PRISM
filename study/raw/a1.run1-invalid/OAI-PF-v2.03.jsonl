{"unit_id": "OAI-PF-v2-0342", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Access Management / sub-bullet 2", "unit_type": "bullet", "context_stem": "Access Management", "excerpt": "Identity and Device Management: Employees must authenticate using multi-factor authentication (MFA) and managed devices meeting security baselines.", "paraphrase": "Employees must use MFA and managed devices meeting security baselines to authenticate.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0343", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Access Management / sub-bullet 2", "unit_type": "bullet", "context_stem": "Identity and Device Management", "excerpt": "Access must be logged and reviewed for detection and investigative purposes.", "paraphrase": "Access must be logged and reviewed to support detection and investigation.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0344", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Secure Development and Supply Chain / sub-bullet 1", "unit_type": "bullet", "context_stem": "Secure Development and Supply Chain", "excerpt": "Secure Development Lifecycle: Integrate automated code analysis, formal security reviews, and penetration testing in engineering processes.", "paraphrase": "The secure development lifecycle must integrate automated code analysis, formal security reviews, and penetration testing.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0345", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Secure Development and Supply Chain / sub-bullet 1", "unit_type": "bullet", "context_stem": "Secure Development Lifecycle", "excerpt": "Apply security reviews and validation to higher-sensitivity critical components prior to deployment.", "paraphrase": "Security reviews and validation must be applied to higher-sensitivity critical components before deployment.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0346", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Secure Development and Supply Chain / sub-bullet 2", "unit_type": "bullet", "context_stem": "Secure Development and Supply Chain", "excerpt": "Change Management: Establish and maintain a formal change management process to ensure that all modifications to systems, applications, and infrastructure are properly authorized, documented, tested, and approved before deployment.", "paraphrase": "A formal change management process must ensure all system modifications are authorized, documented, tested, and approved before deployment.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0347", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Secure Development and Supply Chain / sub-bullet 2", "unit_type": "bullet", "context_stem": "Change Management", "excerpt": "Changes to critical infrastructure should undergo multi-person approval and review.", "paraphrase": "Critical infrastructure changes should require multi-person approval and review.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0348", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Secure Development and Supply Chain / sub-bullet 2", "unit_type": "bullet", "context_stem": "Change Management", "excerpt": "This process should include maintaining comprehensive records of changes and implementing rollback procedures to revert to previous states.", "paraphrase": "The process should maintain comprehensive change records and rollback procedures for reverting to prior states.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0349", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Secure Development and Supply Chain / sub-bullet 3", "unit_type": "bullet", "context_stem": "Secure Development and Supply Chain", "excerpt": "Software Supply Chain Integrity: Enforce supply chain security measures, including sourcing hardware and software from reputable sources, and continuous vetting and monitoring of third-party suppliers and software libraries.", "paraphrase": "Supply chain security measures must be enforced, including sourcing from reputable vendors and continuously vetting third-party suppliers and libraries.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0350", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Operational Security / sub-bullet 1", "unit_type": "bullet", "context_stem": "Operational Security", "excerpt": "Monitoring and Incident Response: Monitor security and event logs continuously to detect, triage, and respond to security incidents rapidly by 24x7 on-call staff.", "paraphrase": "Security and event logs must be continuously monitored for rapid detection, triage, and response by 24x7 on-call staff.", "modal_register": "mandatory", "stated_bar": "24x7", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0351", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Operational Security / sub-bullet 2", "unit_type": "bullet", "context_stem": "Operational Security", "excerpt": "Vulnerability Management: Ensure known vulnerabilities are addressed through consistent patching and corrective actions, minimizing exploitation opportunities.", "paraphrase": "Known vulnerabilities must be addressed via consistent patching and corrective action to minimize exploitation.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0352", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Operational Security / sub-bullet 3", "unit_type": "bullet", "context_stem": "Operational Security", "excerpt": "Adversarial Testing and Red-Teaming: Conduct adversarial testing and red-teaming exercises to proactively identify and mitigate potential vulnerabilities within corporate, research, and product systems, ensuring resilience against unknown vulnerabilities and emerging threats.", "paraphrase": "Adversarial testing and red-teaming must proactively identify and mitigate vulnerabilities across corporate, research, and product systems.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0353", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Operational Security / sub-bullet 3", "unit_type": "bullet", "context_stem": "Adversarial Testing and Red-Teaming", "excerpt": "Encourage reporting of good-faith security research through bug bounty programs.", "paraphrase": "Bug bounty programs are used to encourage reporting of good-faith security research.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0354", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.3 Security controls", "locator": "C.3 / Auditing and Transparency / sub-bullet 1", "unit_type": "bullet", "context_stem": "Auditing and Transparency", "excerpt": "Independent Security Audits: Ensure security controls and practices are validated regularly by third-party auditors to ensure compliance with relevant standards and robustness against identified threats.", "paraphrase": "Third-party auditors must regularly validate security controls for compliance and robustness against identified threats.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
