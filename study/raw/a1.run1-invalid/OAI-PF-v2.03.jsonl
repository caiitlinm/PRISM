{"unit_id": "OAI-PF-v2-0258", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.1 Safeguards against malicious users", "locator": "C.1 / paragraph 1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Several of the Tracked Categories pose risks via malicious users leveraging the frontier capability to enable severe harm, such as professional hackers automating and scaling cyberattacks or terrorists consulting a model to debug the development of a biological weapon.", "paraphrase": "Some Tracked Categories create risk of malicious human misuse, such as hackers scaling cyberattacks or terrorists debugging bioweapon development with model help.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0259", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.1 Safeguards against malicious users", "locator": "C.1 / paragraph 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Safeguards should sufficiently minimize the risk of severe harm associated with misuse of the model's capabilities.", "paraphrase": "Safeguards are expected to sufficiently minimize severe harm risk from misuse of model capabilities.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0260", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.1 Safeguards against malicious users", "locator": "C.1 / paragraph 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This can be done by establishing that all plausible known vectors of enabling severe harm are sufficiently addressed by one or more of the following claims:", "paraphrase": "This is achieved by showing all plausible known severe-harm vectors are addressed by one or more listed claims.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0261", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.1 Safeguards against malicious users", "locator": "C.1 / bullet 1", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Robustness: Users cannot use the model to cause the harm because they cannot elicit the capability, such as because the model is modified to refuse to provide assistance to harmful tasks and is robust to jailbreaks that would circumvent those refusals.", "paraphrase": "The Robustness claim means users cannot elicit the harmful capability due to refusal training that resists jailbreaks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0262", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "C.1 Safeguards against malicious users", "locator": "C.1 / bullet 2", "unit_type": "bullet", "context_stem": "NONE", "excerpt": "Usage Monitoring: If a model does not refuse and provides assistance to harmful tasks, monitors can stop or catch adversarial users before their misuse has achieved an unacceptable scale of harm, through a combination of automated and human detection and enforcement within an acceptable time frame.", "paraphrase": "The Usage Monitoring claim relies on detection systems catching adversarial misuse before it reaches unacceptable scale, within an acceptable time frame.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
