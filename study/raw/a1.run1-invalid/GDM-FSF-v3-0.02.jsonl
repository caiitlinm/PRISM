{"unit_id": "GDM-FSF-v3-0150", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.2 Deployment Mitigations", "locator": "3.1.2 / bullet 3", "unit_type": "numbered", "context_stem": "NONE", "excerpt": "Post-deployment processes: our safety cases and mitigations may be updated if deemed necessary by post-market monitoring. Material updates to a safety case will be submitted to the appropriate governance function for review.", "paraphrase": "Safety cases and mitigations may be updated based on post-market monitoring, and material updates go to governance for review.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0151", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.2 Deployment Mitigations", "locator": "3.1.2 / closing paragraph", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This process is designed to ensure that residual risk remains at acceptable levels: evidence of efficacy collected during development and testing, as well as expert-driven estimates of other parameters, will enable us to assess residual risk and to detect substantial changes that invalidate our risk assessment.", "paraphrase": "The process aims to keep residual risk acceptable by using efficacy evidence and expert estimates to detect assessment-invalidating changes.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0152", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.2 Deployment Mitigations", "locator": "3.1.2 / closing paragraph", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "With iteration on safeguards and safety cases, we believe that we are able to make informed decisions about the level of risk via a CCL before a model is released or deployed internally at scale, and reliably prevent models posing unacceptable levels of risk from being deployed.", "paraphrase": "Iterating on safeguards and safety cases lets the lab make informed pre-release risk decisions and reliably prevent unacceptable risk deployment.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
