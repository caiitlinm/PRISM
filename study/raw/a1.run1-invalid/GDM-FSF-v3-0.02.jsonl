{"unit_id": "GDM-FSF-v3-0156", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.2.1 Machine Learning R&D", "locator": "3.2.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "These capabilities may indicate a heightened ability to undermine human control of models, may incentivize greater (and therefore higher risk) deployment of models, and could also result in the unsafe attainment or proliferation of other powerful AI models if misused by external threat actors.", "paraphrase": "Such capabilities could increase risk of undermining human control, incentivize riskier deployment, or enable unsafe attainment or spread of powerful AI models if misused.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0157", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D acceleration level 1 / Critical Capability Level", "unit_type": "table_cell", "context_stem": "Row label: ML R&D acceleration level 1; Column: Critical Capability Level", "excerpt": "Has been used to accelerate AI development, resulting in AI progress substantially accelerating from historical rates.", "paraphrase": "This CCL is defined as the model having been used to substantially accelerate AI progress beyond historical rates.", "modal_register": "none", "stated_bar": "ML R&D acceleration level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0158", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D acceleration level 1 / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: ML R&D acceleration level 1; Column: Recommended security level and rationale", "excerpt": "Security level 3", "paraphrase": "The recommended security level for ML R&D acceleration level 1 is Security level 3.", "modal_register": "none", "stated_bar": "Security level 3", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0159", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D acceleration level 1 / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: ML R&D acceleration level 1; Column: Recommended security level and rationale", "excerpt": "Unrestricted access to models at this level of capability could significantly increase a threat actor's ability to progress to yet more powerful models and other critical capabilities.", "paraphrase": "Unrestricted access could greatly boost a threat actor's ability to reach more powerful models and other critical capabilities.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0160", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D acceleration level 1 / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: ML R&D acceleration level 1; Column: Recommended security level and rationale", "excerpt": "The exfiltration of such a model may therefore have a significant effect on society's ability to adapt to and govern powerful AI models, effects that may have long-lasting consequences. Substantially strengthened security is therefore recommended.", "paraphrase": "Exfiltration of such a model could meaningfully impair societal governance of powerful AI with lasting effects, warranting substantially strengthened security.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0161", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D acceleration level 1 / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: ML R&D acceleration level 1; Column: Recommended security level and rationale", "excerpt": "However, we expect that acceleration will stem from systems of models integrated with workflows, rather than the model alone. The overall reduced impact of model weights counts against security levels with substantial innovation costs.", "paraphrase": "Because acceleration is expected to come from integrated systems rather than the model alone, this reduces the case for costly security levels tied to model weights alone.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0162", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Footnotes", "locator": "fn14", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "The same caveats regarding security levels for misuse CCLs apply.", "paraphrase": "The same caveats about security levels for misuse CCLs also apply here.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0163", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Footnotes", "locator": "fn15", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "This level may include mitigations aligned with SL 2, plus additional mitigations designed to prevent unilateral access, harden infrastructure, and prevent data exfiltration.", "paraphrase": "Security level 3 may add mitigations to SL2 that prevent unilateral access, harden infrastructure, and prevent data exfiltration.", "modal_register": "conditional", "stated_bar": "SL 2", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0164", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D automation level 1 / Critical Capability Level", "unit_type": "table_cell", "context_stem": "Row label: ML R&D automation level 1; Column: Critical Capability Level", "excerpt": "Can fully automate the work of any team of researchers at Google focused on improving AI capabilities, with approximately comparable all-inclusive costs.", "paraphrase": "This CCL is defined as being able to fully automate any Google AI-capability research team's work at comparable cost.", "modal_register": "none", "stated_bar": "ML R&D automation level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0165", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D automation level 1 / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: ML R&D automation level 1; Column: Recommended security level and rationale", "excerpt": "We recommend Security level 4 for this capability threshold, but emphasize that this must be taken on by the frontier AI field as a whole.", "paraphrase": "Security level 4 is recommended for this CCL, though the lab stresses it requires collective adoption across the frontier AI field.", "modal_register": "mandatory", "stated_bar": "Security level 4", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0166", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D automation level 1 / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: ML R&D automation level 1; Column: Recommended security level and rationale", "excerpt": "Unrestricted access to models at this level of capability could give an actor (or AI systems) with adequate computational resources the ability to reach capabilities much more powerful than those in the other CCLs listed in a short amount of time.", "paraphrase": "Unrestricted access at this level could let a well-resourced actor or AI system rapidly reach far more powerful capabilities than other listed CCLs.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0167", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D automation level 1 / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: ML R&D automation level 1; Column: Recommended security level and rationale", "excerpt": "This could be catastrophic if there is no effective way of defending against rapidly improving and potentially superhuman AI systems wielded by threat actors.", "paraphrase": "Without effective defenses against rapidly improving, potentially superhuman AI wielded by threat actors, the outcome could be catastrophic.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0168", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 3.2.1.a: Machine Learning R&D CCLs and Security Mitigations", "locator": "Table 3.2.1.a / ML R&D automation level 1 / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: ML R&D automation level 1; Column: Recommended security level and rationale", "excerpt": "Therefore, we recommend models at this level of capability have exceptional security even though they may have substantial innovation costs.", "paraphrase": "Exceptional security is recommended for this capability level despite potentially high innovation costs.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0169", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Footnotes", "locator": "fn16", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "This level may include mitigations aligned with SL 2 and 3, plus additional mitigations aimed to isolate model weights, enhanced data center security, further hardening of infrastructure and minimizing potential attack surface.", "paraphrase": "Security level 4 may add to SL2/3 mitigations by isolating model weights, enhancing data center security, hardening infrastructure, and reducing attack surface.", "modal_register": "conditional", "stated_bar": "SL 2 and 3", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0170", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Section 4: Misalignment (Exploratory Approach)", "locator": "Section 4 intro", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Misalignment can pose a number of risks. In the context of the Framework, we address specific scenarios where general-purpose AI agents are potentially misaligned and can become difficult to control, thereby posing a risk of severe harm.", "paraphrase": "The framework addresses misalignment scenarios where general-purpose AI agents become hard to control, risking severe harm.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0171", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Section 4: Misalignment (Exploratory Approach)", "locator": "Section 4 intro", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Here we describe an approach for addressing misalignment risk that focuses specifically on when models may develop a baseline instrumental reasoning ability at which, without additional mitigations, they may have the potential to undermine human control.", "paraphrase": "The approach targets the point at which a model's instrumental reasoning could threaten human control absent further mitigations.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0172", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Section 4: Misalignment (Exploratory Approach)", "locator": "Section 4 intro", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "When models reach this capability level, one possible mitigation is to apply an automated monitor to the model's explicit reasoning (e.g. chain-of-thought output).", "paraphrase": "A possible mitigation at this capability level is automated monitoring of the model's explicit chain-of-thought reasoning.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0173", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Section 4: Misalignment (Exploratory Approach)", "locator": "Section 4 intro", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Once a model is capable of effective instrumental reasoning in ways that cannot be monitored, additional mitigations may be warranted—the development of which is an area of active research.", "paraphrase": "When a model's instrumental reasoning cannot be monitored, additional mitigations, still under active research, may be needed.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0174", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Section 4: Misalignment (Exploratory Approach)", "locator": "Section 4 / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Given its nascency, we expect our approach to misalignment risk to evolve substantially. This section is therefore illustrative only.", "paraphrase": "Because this area is nascent, the misalignment approach is expected to evolve substantially and this section is only illustrative.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0175", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Section 4: Misalignment (Exploratory Approach)", "locator": "Section 4 / para 2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Accordingly, we do not indicate security mitigations for models at these CCLs. The table below summarizes the initial approach:", "paraphrase": "No security mitigations are specified for these misalignment CCLs; the table gives an initial summary.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0176", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 4.a: Exploratory Misalignment CCLs and Mitigations", "locator": "Table 4.a / Instrumental Reasoning Level 1 / Illustrative Instrumental Reasoning CCL", "unit_type": "table_cell", "context_stem": "Row label: Instrumental Reasoning Level 1; Column: Illustrative Instrumental Reasoning CCL", "excerpt": "The instrumental reasoning abilities of the model enable enough situational awareness (ability to work out and use relevant details of its deployment setting) and stealth (ability to circumvent basic oversight mechanisms) such that, absent additional mitigations, we cannot rule out the model significantly undermining human control.", "paraphrase": "This CCL is defined as the model having enough situational awareness and stealth that, without extra mitigations, it might significantly undermine human control.", "modal_register": "conditional", "stated_bar": "Instrumental Reasoning Level 1", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0177", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 4.a: Exploratory Misalignment CCLs and Mitigations", "locator": "Table 4.a / Instrumental Reasoning Level 1 / Illustrative Mitigation", "unit_type": "table_cell", "context_stem": "Row label: Instrumental Reasoning Level 1; Column: Illustrative Mitigation", "excerpt": "Automated monitoring: monitoring system to detect illicit use of instrumental reasoning capabilities in a model's chain-of-thought may be applied in high-stakes internal deployments where there is significant risk of the model undermining human control.", "paraphrase": "A suggested mitigation is an automated monitoring system for illicit chain-of-thought reasoning in high-stakes internal deployments with significant control-undermining risk.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0178", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 4.a: Exploratory Misalignment CCLs and Mitigations", "locator": "Table 4.a / Instrumental Reasoning Level 2 / Illustrative Instrumental Reasoning CCL", "unit_type": "table_cell", "context_stem": "Row label: Instrumental Reasoning Level 2; Column: Illustrative Instrumental Reasoning CCL", "excerpt": "The instrumental reasoning abilities of the model enable enough situational awareness and stealth that, even when relevant model outputs (including, e.g. scratchpads) are being monitored, we cannot detect or rule out the risk of a model significantly undermining human control.", "paraphrase": "This CCL is defined as the model having enough situational awareness and stealth that even monitored outputs cannot rule out significant undermining of human control.", "modal_register": "conditional", "stated_bar": "Instrumental Reasoning Level 2", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0179", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 4.a: Exploratory Misalignment CCLs and Mitigations", "locator": "Table 4.a / Instrumental Reasoning Level 2 / Illustrative Mitigation", "unit_type": "table_cell", "context_stem": "Row label: Instrumental Reasoning Level 2; Column: Illustrative Mitigation", "excerpt": "Future work: We are actively researching approaches to addressing models that reach this CCL.", "paraphrase": "The lab is actively researching mitigation approaches for models reaching this CCL, with no mitigation yet defined.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0180", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "5.1 Updates", "locator": "5.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The Frontier Safety Framework will be updated at least once a year—more frequently if we have reasonable grounds to believe the adequacy of the Framework or our adherence to it has been materially undermined.", "paraphrase": "The Framework is updated at least annually, or more often if its adequacy or the lab's adherence is materially undermined.", "modal_register": "mandatory", "stated_bar": "at least once a year", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0181", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "5.1 Updates", "locator": "5.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "The process will involve (i) an assessment of the Framework's appropriateness for the management of systemic risk, drawing on information sources such as record of adherence to the framework, relevant high-quality research, information shared through industry forums, and evaluation results, as necessary, and (ii) an assessment of our adherence to the Framework.", "paraphrase": "The update process includes assessing the Framework's appropriateness using various information sources, and assessing the lab's own adherence.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
