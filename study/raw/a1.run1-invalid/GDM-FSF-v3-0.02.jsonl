{"unit_id": "GDM-FSF-v3-0142", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.2 Deployment Mitigations", "locator": "3.1.2 / bullet 1.a", "unit_type": "numbered", "context_stem": "Development and assessment of mitigations: safeguards and an accompanying safety case are developed by iterating on the following:", "excerpt": "Developing and improving a suite of safeguards targeting the capability, which may include measures such as limiting affordances, monitoring and escalation, auditing, and alignment training, in addition to measures for preventing large scale misuse.", "paraphrase": "Safeguards for the capability are developed and improved, potentially including affordance limits, monitoring, escalation, auditing, and alignment training, alongside anti-misuse measures.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0143", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.2 Deployment Mitigations", "locator": "3.1.2 / bullet 1.b", "unit_type": "numbered", "context_stem": "Development and assessment of mitigations: safeguards and an accompanying safety case are developed by iterating on the following:", "excerpt": "Assessing the robustness of these mitigations against the risk posed in both internal and external deployment through testing (e.g. automated evaluations, red teaming) and threat modeling research. The assessment takes the form of a safety case, taking into account factors such as:", "paraphrase": "Mitigation robustness is assessed via testing and threat modeling, producing a safety case that considers several factors.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0144", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.2 Deployment Mitigations", "locator": "3.1.2 / bullet 1.b.i", "unit_type": "bullet", "context_stem": "The assessment takes the form of a safety case, taking into account factors such as:", "excerpt": "How much the risk has been reduced by mitigations. For example, tests run on the safeguards may suggest that it is very unlikely they can be circumvented by external threat actors or the model in question to increase ML R&D risk.", "paraphrase": "One factor is the degree of risk reduction achieved, evidenced by tests suggesting mitigations are unlikely to be circumvented.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0145", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.2 Deployment Mitigations", "locator": "3.1.2 / bullet 1.b.ii", "unit_type": "bullet", "context_stem": "The assessment takes the form of a safety case, taking into account factors such as:", "excerpt": "The likelihood and consequences of model misuse or misalignment, capability improvements after the risk assessment, and likelihood and consequences of our mitigations being circumvented, deactivated, or subverted.", "paraphrase": "Another factor covers likelihood and consequences of misuse, misalignment, post-assessment capability gains, and mitigation circumvention.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
