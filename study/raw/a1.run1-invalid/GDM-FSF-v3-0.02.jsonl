{"unit_id": "GDM-FSF-v3-0134", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 2.2.3.a: Harmful Manipulation CCLs and Security Mitigations", "locator": "Table 2.2.3.a / 1 (exploratory) / Critical Capability Level", "unit_type": "table_cell", "context_stem": "Row label: 1 (exploratory); Column: Critical Capability Level", "excerpt": "Possesses manipulative capabilities sufficient to enable it to systematically and substantially change beliefs and behavior in identified high stakes contexts over the course of interactions with the model, reasonably resulting in additional expected harm at severe scale.", "paraphrase": "This CCL is defined by the model's ability to systematically alter beliefs and behavior in high-stakes contexts, resulting in severe-scale harm.", "modal_register": "none", "stated_bar": "1 (exploratory)", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0135", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Table 2.2.3.a: Harmful Manipulation CCLs and Security Mitigations", "locator": "Table 2.2.3.a / 1 (exploratory) / Recommended security level and rationale", "unit_type": "table_cell", "context_stem": "Row label: 1 (exploratory); Column: Recommended security level and rationale", "excerpt": "The lower velocity of harm scenarios associated with this CCL and the viability of social defenses against large scale misuse of such models count against security mitigations with substantial costs to innovation.", "paraphrase": "Because harm from this CCL develops slowly and social defenses are viable, costly security mitigations are not currently justified.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0136", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "Section 3: Machine Learning R&D", "locator": "Section 3 intro", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This section describes our mitigation approach for models that pose risks of severe harm through machine learning R&D, and then details our set of ML R&D CCLs, as well as the mitigations that we provisionally assess as appropriate for them.", "paraphrase": "This section covers mitigation approaches, CCLs, and mitigations for severe harm risks arising from ML R&D capabilities.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0137", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1 Mitigation Approach", "locator": "3.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "As with misuse CCLs, we designate security and deployment mitigations for ML R&D CCLs, although deployment mitigations focus on different threat models and therefore also include measures for large scale internal deployments.", "paraphrase": "ML R&D CCLs have security and deployment mitigations similar to misuse CCLs, but deployment mitigations also address large-scale internal deployments.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0138", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.1 Security Mitigations", "locator": "3.1.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Security mitigations against exfiltration risk are important for models reaching ML R&D CCLs, because the exfiltration of highly capable models increases the likelihood they will be misused to achieve other critical capabilities, or deployed without adequate control and oversight.", "paraphrase": "Security mitigations against exfiltration matter because stolen highly capable models risk being misused or deployed without oversight.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "GDM-FSF-v3-0139", "source_version": "target", "lab_name": "Google DeepMind", "framework_name": "Frontier Safety Framework", "framework_version": "Version 3.0", "framework_year": 2025, "section_heading": "3.1.1 Security Mitigations", "locator": "3.1.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Below, we rely again on security levels to articulate the security goal recommended for each CCL. Security mitigations also protect against the risk of the model exfiltrating itself.", "paraphrase": "Security levels are again used to describe the recommended security goal for each CCL, and these mitigations also guard against self-exfiltration.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
