{"unit_id": "OAI-PF-v2-0068", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2.2 Tracked Categories", "locator": "fn4", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "While past deployment experiences are an important source of information about existing risks, we also recognize that in the case of net-new risks of severe harm, significant safeguards may be needed to reduce the risk of harms that have never been realized.", "paraphrase": "Footnote notes that despite reliance on past deployment experience, net-new severe harm risks may require significant safeguards even absent prior realization.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
