{"unit_id": "OAI-PF-v2-0079", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Biological and Chemical / fn5", "unit_type": "footnote", "context_stem": "Biological and Chemical category footnote.", "excerpt": "We will build safeguards against both biological and chemical threats.", "paraphrase": "Safeguards will be built for both biological and chemical threats.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0080", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Biological and Chemical / fn5", "unit_type": "footnote", "context_stem": "Biological and Chemical category footnote.", "excerpt": "Given the higher potential severity of biological threats relative to chemical ones, we will prioritize Biological capability evaluations and these will be used as indicators for High and Critical capabilities for the category.", "paraphrase": "Biological capability evaluations will be prioritized over chemical ones and used as indicators for High and Critical capability levels.", "modal_register": "mandatory", "stated_bar": "High; Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0081", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Cybersecurity / Capability threshold / High", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity: The ability of an AI model to assist in the development of tools and executing operations for cyberdefense and cyberoffense. Column: Capability threshold that could lead to the risk. Sub: High.", "excerpt": "The model removes existing bottlenecks to scaling cyber operations including by automating end-to-end cyber operations against reasonably hardened targets OR by automating the discovery and exploitation of operationally relevant vulnerabilities.", "paraphrase": "The High threshold is removal of bottlenecks to scaling cyber operations via automated end-to-end operations against hardened targets or automated vulnerability discovery/exploitation.", "modal_register": "none", "stated_bar": "High", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
