{"unit_id": "OAI-PF-v2-0075", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Biological and Chemical / Capability threshold / Critical", "unit_type": "table_cell", "context_stem": "Row: Biological and Chemical. Column: Capability threshold that could lead to the risk. Sub: Critical.", "excerpt": "The model can enable an expert to develop a highly dangerous novel threat vector (e.g., comparable to a novel CDC Class A biological agent) OR the model can be connected to tools and equipment to complete the full engineering and/or synthesis cycle of a regulated or novel biological threat without human intervention.", "paraphrase": "The Critical threshold is enabling an expert to create a highly dangerous novel threat vector, or model-driven completion of a full engineering/synthesis cycle for a regulated or novel biological threat without human involvement.", "modal_register": "none", "stated_bar": "Critical; comparable to a novel CDC Class A biological agent", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0076", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Biological and Chemical / Associated risk of severe harm / Critical", "unit_type": "table_cell", "context_stem": "Row: Biological and Chemical. Column: Associated risk of severe harm. Sub: Critical.", "excerpt": "Proliferating the ability to create a novel threat vector of the severity of a CDC Class A biological agent (i.e., high mortality, ease of transmission) could cause millions of deaths and significantly disrupt public life, with few available societal safeguards.", "paraphrase": "The Critical associated risk is that proliferation of a CDC Class A-level threat vector could cause millions of deaths and severely disrupt public life.", "modal_register": "none", "stated_bar": "millions of deaths; CDC Class A biological agent severity", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
