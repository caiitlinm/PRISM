{"unit_id": "OAI-PF-v2-0091", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Cybersecurity / Risk-specific safeguard guidelines / Critical", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity. Column: Risk-specific safeguard guidelines. Sub: Critical.", "excerpt": "Until we have specified safeguards and security controls standards that would meet a Critical standard, halt further development", "paraphrase": "Development halts until safeguards and security control standards meeting the Critical standard are specified.", "modal_register": "mandatory", "stated_bar": "Critical", "duplicate_of": "OAI-PF-v2-0077", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0092", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / AI Self-improvement / Capability threshold / High", "unit_type": "table_cell", "context_stem": "Row: AI Self-improvement: The ability of an AI system to accelerate AI research, including to increase the system’s own capability. Column: Capability threshold that could lead to the risk. Sub: High.", "excerpt": "The model’s impact is equivalent to giving every OpenAI researcher a highly performant mid-career research engineer assistant, relative to those researchers’ 2024 baseline.", "paraphrase": "The High threshold is model impact equivalent to giving every OpenAI researcher a highly performant mid-career research engineer assistant relative to 2024 baseline.", "modal_register": "none", "stated_bar": "High; relative to 2024 baseline", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0093", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / AI Self-improvement / Associated risk of severe harm / High / part 1", "unit_type": "table_cell", "context_stem": "Row: AI Self-improvement. Column: Associated risk of severe harm. Sub: High.", "excerpt": "This milestone suggests AI self-improvement may be beginning to accelerate.", "paraphrase": "This High milestone suggests AI self-improvement may be starting to accelerate.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0094", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / AI Self-improvement / Associated risk of severe harm / High / part 2", "unit_type": "table_cell", "context_stem": "Row: AI Self-improvement. Column: Associated risk of severe harm. Sub: High.", "excerpt": "To meet the large-scale safety research, operations, and security investments that need to be in place when we reach Critical self-improvement, we will by then need to have made significant progress on those investments at this earlier milestone to avoid later risks.", "paraphrase": "Significant progress on large-scale safety, operations, and security investments must be made at this High milestone to be ready for Critical self-improvement and avoid later risks.", "modal_register": "mandatory", "stated_bar": "Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0095", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / AI Self-improvement / Risk-specific safeguard guidelines / High", "unit_type": "table_cell", "context_stem": "Row: AI Self-improvement. Column: Risk-specific safeguard guidelines. Sub: High.", "excerpt": "Require security controls meeting High standard (Appendix C.3)", "paraphrase": "Require security controls meeting the High standard per Appendix C.3.", "modal_register": "mandatory", "stated_bar": "High", "duplicate_of": "OAI-PF-v2-0073", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0096", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / AI Self-improvement / Capability threshold / Critical", "unit_type": "table_cell", "context_stem": "Row: AI Self-improvement. Column: Capability threshold that could lead to the risk. Sub: Critical.", "excerpt": "The model is capable of recursively self improving (i.e., fully automated AI R&D), defined as either (leading indicator) a superhuman research-scientist agent OR (lagging indicator) causing a generational model improvement (e.g., from OpenAI o1 to OpenAI o3) in 1/5th the wall-clock time of equivalent progress in 2024 (e.g., sped up to just 4 weeks) sustainably for several months.", "paraphrase": "The Critical threshold is recursive self-improvement (fully automated AI R&D), indicated by a superhuman research-scientist agent, or a generational model improvement achieved in one-fifth the 2024 wall-clock time, sustained for months.", "modal_register": "none", "stated_bar": "Critical; 1/5th the wall-clock time of 2024 progress (e.g., 4 weeks) sustained for several months", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0097", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / AI Self-improvement / Associated risk of severe harm / Critical", "unit_type": "table_cell", "context_stem": "Row: AI Self-improvement. Column: Associated risk of severe harm. Sub: Critical.", "excerpt": "A major acceleration in the rate of AI R&D could rapidly increase the rate at which new capabilities and risks emerge, to the point where our current oversight practices are insufficient to identify and mitigate new risks, including risks to maintaining human control of the AI system itself.", "paraphrase": "A major AI R&D acceleration could outpace current oversight practices, risking loss of ability to identify, mitigate new risks, and maintain human control.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0098", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / AI Self-improvement / Risk-specific safeguard guidelines / Critical", "unit_type": "table_cell", "context_stem": "Row: AI Self-improvement. Column: Risk-specific safeguard guidelines. Sub: Critical.", "excerpt": "Until we have specified safeguards and security controls that would meet a Critical standard, halt further development", "paraphrase": "Development halts until safeguards and security controls meeting the Critical standard are specified.", "modal_register": "mandatory", "stated_bar": "Critical", "duplicate_of": "OAI-PF-v2-0077", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0099", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2.3 Research Categories", "locator": "2.3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "There are also some areas of frontier capability that do not meet the criteria to be Tracked Categories, but where we believe work is required now in order to prepare to effectively address risks of severe harms in the future.", "paraphrase": "Some capability areas do not meet Tracked Category criteria, but OpenAI believes work is needed now to prepare for future severe harm risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
