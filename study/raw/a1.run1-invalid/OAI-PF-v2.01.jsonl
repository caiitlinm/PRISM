{"unit_id": "OAI-PF-v2-0088", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Cybersecurity / Capability threshold / Critical", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity. Column: Capability threshold that could lead to the risk. Sub: Critical.", "excerpt": "A tool-augmented model can identify and develop functional zero-day exploits of all severity levels in many hardened real-world critical systems without human intervention OR model can devise and execute end-to-end novel strategies for cyberattacks against hardened targets given only a high level desired goal.", "paraphrase": "The Critical threshold is autonomous discovery/development of zero-day exploits in hardened systems, or autonomous devising and execution of novel cyberattack strategies from a high-level goal.", "modal_register": "none", "stated_bar": "Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
