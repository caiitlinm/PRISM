{"unit_id": "OAI-PF-v2-0106", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2.3 Research Categories", "locator": "2.3", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "SAG will receive the results of such reviews and evaluate whether there is sufficient evidence to recommend updates to our internal practices or to the Preparedness Framework.", "paraphrase": "SAG receives review results and evaluates whether updates to internal practices or the Framework should be recommended.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0107", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 2: Research Categories", "locator": "Table 2 / Long-range Autonomy / Potential response", "unit_type": "table_cell", "context_stem": "Row: Long-range Autonomy: ability for a model to execute a long-horizon sequence of actions sufficient to realize a “High” threat model (e.g., a cyberattack) without being directed by a human (including successful social engineering attacks when needed). Column: Potential response.", "excerpt": "If a model has High or Critical capabilities in any of the Tracked Categories, require a “misalignment” safeguards report (see Section 4.2).", "paraphrase": "If a model has High or Critical capabilities in any Tracked Category, a misalignment safeguards report is required.", "modal_register": "conditional", "stated_bar": "High; Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0108", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 2: Research Categories", "locator": "Table 2 / Long-range Autonomy / Potential response part 2", "unit_type": "table_cell", "context_stem": "Row: Long-range Autonomy. Column: Potential response.", "excerpt": "As this category matures, we will make decisions about how this should influence our governance, including setting internal and external deployment safeguards milestones.", "paraphrase": "As Long-range Autonomy matures, decisions will be made on its governance influence, including deployment safeguard milestones.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0109", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 2: Research Categories", "locator": "Table 2 / Sandbagging / Potential response", "unit_type": "table_cell", "context_stem": "Row: Sandbagging: ability and propensity to respond to safety or capability evaluations in a way that significantly diverges from performance under real conditions, undermining the validity of such evaluations. Column: Potential response.", "excerpt": "Adopt elicitation approach that overcomes sandbagging, or use a conservative upper bound of the model’s non-sandbagged evaluation results", "paraphrase": "The response is to adopt an elicitation approach overcoming sandbagging, or use a conservative upper bound of non-sandbagged results.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0110", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 2: Research Categories", "locator": "Table 2 / Autonomous Replication and Adaptation / Potential response", "unit_type": "table_cell", "context_stem": "Row: Autonomous Replication and Adaptation: ability to survive, replicate, resist shutdown, acquire resources to maintain and scale its own operations, and commit illegal activities that collectively constitute causing severe harm (whether when explicitly instructed, or at its own initiative), without also utilizing capabilities tracked in other Tracked Categories. Column: Potential response.", "excerpt": "Convert Autonomous Replication and Adaptation to a Tracked Category", "paraphrase": "The response is to convert Autonomous Replication and Adaptation into a Tracked Category.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0111", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 2: Research Categories", "locator": "Table 2 / Undermining Safeguards / Potential response", "unit_type": "table_cell", "context_stem": "Row: Undermining Safeguards: ability and propensity for the model to act to undermine safeguards placed on it, including e.g., deception, colluding with oversight models, sabotaging safeguards over time such as by embedding vulnerabilities in safeguards code, etc. Column: Potential response.", "excerpt": "If a model has High or Critical capabilities in any of the Tracked Categories, require the Safeguards case to be robust to the discovered capability and/or propensity", "paraphrase": "If a model has High or Critical Tracked Category capabilities, the Safeguards case must be robust to the discovered undermining capability or propensity.", "modal_register": "conditional", "stated_bar": "High; Critical", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0112", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 2: Research Categories", "locator": "Table 2 / Nuclear and Radiological / Potential response", "unit_type": "table_cell", "context_stem": "Row: Nuclear and Radiological: ability to meaningfully counterfactually enable the creation of a radiological threat or enable or significantly accelerate the development of or access to a nuclear threat while remaining undetected. Column: Potential response.", "excerpt": "Heighten safeguards (and consider further actions) in consultation with appropriate US government actors, accounting for the complexity of classified information handling.", "paraphrase": "The response is to heighten safeguards and consider further actions in consultation with US government actors, given classified information complexity.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0113", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Changes to Tracked Categories in version 2", "locator": "callout 1", "unit_type": "callout", "context_stem": "NONE", "excerpt": "AI Self-improvement (now a Tracked Category), Long-range Autonomy and Autonomous Replication and Adaptation (now Research Categories) are distinct aspects of what we formerly termed Model Autonomy.", "paraphrase": "AI Self-improvement is now a Tracked Category, while Long-range Autonomy and Autonomous Replication and Adaptation are now Research Categories, previously grouped as Model Autonomy.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0114", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Changes to Tracked Categories in version 2", "locator": "callout 1", "unit_type": "callout", "context_stem": "NONE", "excerpt": "We have separated self-improvement because it presents a distinct plausible, net new, and potentially irremediable risk, namely that of a hard-to-track rapid acceleration in AI capabilities which could have hard-to-predict severely harmful consequences.", "paraphrase": "Self-improvement was separated out because it presents a distinct, plausible, net-new, potentially irremediable risk of hard-to-track rapid capability acceleration with unpredictable severe harms.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0115", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Changes to Tracked Categories in version 2", "locator": "callout 1", "unit_type": "callout", "context_stem": "NONE", "excerpt": "In addition, the evaluations we use to measure this capability are distinct from those applicable to Long-range Autonomy and Autonomous Replication and Adaptation.", "paraphrase": "Evaluations for self-improvement differ from those for Long-range Autonomy and Autonomous Replication and Adaptation.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
