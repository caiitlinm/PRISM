{"unit_id": "OAI-PF-v2-0083", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Cybersecurity / Associated risk of severe harm / High / part 2", "unit_type": "table_cell", "context_stem": "Row: Cybersecurity. Column: Associated risk of severe harm. Sub: High.", "excerpt": "In conjunction with a Long-range Autonomy capability (Section 2.3), models that could bypass OpenAI’s technical safeguards constraining model activity, such as sandboxing or monitoring services, could compromise OpenAI’s ability to track and mitigate all other risks.", "paraphrase": "Combined with Long-range Autonomy, models bypassing technical safeguards like sandboxing could compromise OpenAI's ability to track and mitigate all risks.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
