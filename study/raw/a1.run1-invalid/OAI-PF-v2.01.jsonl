{"unit_id": "OAI-PF-v2-0034", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 1", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways: Safeguarding stronger models will require more planning and coordination.", "excerpt": "Our evaluations have so far shown that even our most advanced models, even without safeguards in place, aren’t yet capable enough to pose severe risks in areas like bio- or cybersecurity.", "paraphrase": "Evaluations show the most advanced models, even unsafeguarded, are not yet capable enough to pose severe bio- or cybersecurity risks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0035", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 1", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways: Safeguarding stronger models will require more planning and coordination.", "excerpt": "We are on the cusp of systems that can do new science, and that are increasingly agentic - systems that will soon have the capability to create meaningful risk of severe harm.", "paraphrase": "OpenAI is approaching systems capable of new science and increasing agency that will soon create meaningful severe harm risk.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0036", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 1", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways: Safeguarding stronger models will require more planning and coordination.", "excerpt": "This means we will need to design and deploy safeguards we can rely on for safety and security – which requires a new level of planning and coordination across the company, beyond what’s needed to measure capabilities.", "paraphrase": "OpenAI will need reliable safeguards and greater company-wide planning and coordination, beyond mere capability measurement.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0037", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 2", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways:", "excerpt": "More frequent deployments require scalable evaluations.", "paraphrase": "More frequent deployments require evaluations that scale.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0038", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 2", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways: More frequent deployments require scalable evaluations.", "excerpt": "Today, we’re able to develop and deploy better models more often than ever thanks to reasoning advances that can unlock new capabilities without as much training as the previous paradigm.", "paraphrase": "Reasoning advances now allow more frequent development and deployment of better models with less training than before.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0039", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 2", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways: More frequent deployments require scalable evaluations.", "excerpt": "As a result, it’s important to embrace methods that scale, including scalable capability evaluations that work well for a faster cadence of model deployment, as well as periodic deeper dives that validate those scalable evaluations.", "paraphrase": "OpenAI states it is important to adopt scalable evaluation methods plus periodic deeper validation dives.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0040", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 3", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways:", "excerpt": "A highly dynamic development landscape for frontier AI makes it important for us to share our latest thinking.", "paraphrase": "The dynamic frontier AI landscape makes sharing OpenAI's latest thinking important.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0041", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 3", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways: A highly dynamic development landscape for frontier AI makes it important for us to share our latest thinking.", "excerpt": "With a growing number of labs producing frontier AI models, it is more important than ever for us and other labs to contribute to community efforts on frontier safety and security, including by adapting safety work for the reasoning paradigm and for increasingly agentic systems, and advocating for and contributing to advanced protection measures in a world of continual frontier AI proliferation.", "paraphrase": "As more labs produce frontier models, OpenAI and peers should contribute to community safety and security efforts, adapting to new paradigms and advocating protective measures amid proliferation.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0042", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 4", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways:", "excerpt": "We and the broader field have gained more experience and built conviction on how to do this work.", "paraphrase": "OpenAI and the field have gained more experience and confidence in how to do this safety work.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0043", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 4", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways: We and the broader field have gained more experience and built conviction on how to do this work.", "excerpt": "The past year of research and deployment on safety frameworks both at OpenAI and across the AI field have given us greater clarity on how to prioritize and approach categories of risk.", "paraphrase": "A year of research and deployment across the field has clarified how to prioritize and approach risk categories.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0044", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "bullet 4", "unit_type": "bullet", "context_stem": "Our environment is changing in four key ways: We and the broader field have gained more experience and built conviction on how to do this work.", "excerpt": "This includes our threat modelling, development work on new capability evaluations, and external consultations, as well as relevant publications from external researchers and updated frameworks from industry peers.", "paraphrase": "This experience includes threat modeling, new capability evaluation development, external consultations, and industry publications and frameworks.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0045", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "1.1 Why we’re updating the Preparedness Framework", "locator": "fn2", "unit_type": "footnote", "context_stem": "NONE", "excerpt": "For example, our adoption of Capability Reports and Safeguards Reports parallels Anthropic’s updated RSP.", "paraphrase": "Footnote notes that Capability Reports and Safeguards Reports parallel Anthropic's updated RSP.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0046", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We evaluate whether frontier capabilities create a risk of severe harm through a holistic risk assessment process.", "paraphrase": "OpenAI evaluates whether frontier capabilities pose severe harm risk via a holistic risk assessment process.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0047", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "This process draws on our own internal research and signals, and where appropriate incorporates feedback from academic researchers, independent domain experts, industry bodies such as the Frontier Model Forum, and the U.S. government and its partners, as well as relevant legal and policy mandates.", "paraphrase": "The risk assessment process draws on internal research and, where appropriate, external feedback from academics, experts, industry bodies, and government, plus legal/policy mandates.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0048", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Where we determine that a capability presents a real risk of severe harm, we may decide to monitor it as a Tracked Category or a Research Category.", "paraphrase": "Where a capability presents real severe harm risk, OpenAI may monitor it as a Tracked or Research Category.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0049", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Tracked Categories are those capabilities which we track most closely, measuring them during each covered deployment and preparing safeguards for when a threshold level is crossed.", "paraphrase": "Tracked Categories are closely tracked capabilities, measured at each covered deployment, with safeguards prepared for threshold crossings.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0050", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We treat a frontier capability as a Tracked Category if the capability creates a risk that meets five criteria:", "paraphrase": "A frontier capability is treated as a Tracked Category if it creates a risk meeting five criteria.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0051", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1 / criterion 1", "unit_type": "numbered", "context_stem": "We treat a frontier capability as a Tracked Category if the capability creates a risk that meets five criteria:", "excerpt": "Plausible: It must be possible to identify a causal pathway for a severe harm in the capability area, enabled by frontier AI.", "paraphrase": "The plausible criterion requires an identifiable causal pathway to severe harm enabled by frontier AI.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0052", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1 / criterion 2", "unit_type": "numbered", "context_stem": "We treat a frontier capability as a Tracked Category if the capability creates a risk that meets five criteria:", "excerpt": "Measurable: We can construct or adopt capability evaluations that measure capabilities that closely track the potential for the severe harm.", "paraphrase": "The measurable criterion requires evaluations that closely track potential for severe harm.", "modal_register": "conditional", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0053", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1 / criterion 3", "unit_type": "numbered", "context_stem": "We treat a frontier capability as a Tracked Category if the capability creates a risk that meets five criteria:", "excerpt": "Severe: There is a plausible threat model within the capability area that would create severe harm.", "paraphrase": "The severe criterion requires a plausible threat model that would create severe harm.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0054", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1 / criterion 4", "unit_type": "numbered", "context_stem": "We treat a frontier capability as a Tracked Category if the capability creates a risk that meets five criteria:", "excerpt": "Net new: The outcome cannot currently be realized as described (including at that scale, by that threat actor, or for that cost) with existing tools and resources (e.g., available as of 2021) but without access to frontier AI.", "paraphrase": "The net new criterion requires the outcome be currently unachievable without frontier AI using existing tools as of 2021.", "modal_register": "none", "stated_bar": "as of 2021", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0055", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1 / criterion 5", "unit_type": "numbered", "context_stem": "We treat a frontier capability as a Tracked Category if the capability creates a risk that meets five criteria:", "excerpt": "Instantaneous or irremediable: The outcome is such that once realized, its severe harms are immediately felt, or are inevitable due to a lack of feasible measures to remediate.", "paraphrase": "The instantaneous or irremediable criterion requires that harms are immediate or unavoidable once realized.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0056", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "We review and update Tracked Categories periodically or when we learn significant new information.", "paraphrase": "Tracked Categories are reviewed and updated periodically or upon significant new information.", "modal_register": "aspirational", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0057", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2 Deciding where to focus", "locator": "2.1", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Research Categories are capabilities that, while they do not meet the above criteria, nonetheless have the potential to cause or contribute to severe harm, and where we are working now in order to prepare to address risks in the future (including potentially by maturing them to Tracked Categories).", "paraphrase": "Research Categories are capabilities not meeting Tracked Category criteria but with potential to contribute to severe harm, being worked on now.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0058", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2.2 Tracked Categories", "locator": "2.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "For each Tracked Category, we develop and maintain a threat model identifying specific risks of severe harms that could arise from the frontier capabilities in that domain and sets corresponding capability thresholds that would lead to a meaningful increase in risk of severe harm.", "paraphrase": "For each Tracked Category, OpenAI maintains a threat model of specific severe harm risks and corresponding capability thresholds.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0059", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2.2 Tracked Categories", "locator": "2.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "SAG reviews and approves these threat models.", "paraphrase": "SAG reviews and approves the threat models.", "modal_register": "mandatory", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0060", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2.2 Tracked Categories", "locator": "2.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "Capability thresholds concretely describe things an AI system might be able to help someone do or might be able to do on its own that could meaningfully increase risk of severe harm.", "paraphrase": "Capability thresholds concretely describe capabilities that meaningfully increase severe harm risk, whether assisting a person or acting alone.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0061", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "2.2 Tracked Categories", "locator": "2.2", "unit_type": "paragraph", "context_stem": "NONE", "excerpt": "High capability thresholds mean capabilities that significantly increase existing risk vectors for severe harm.", "paraphrase": "High thresholds are defined as capabilities that significantly increase existing severe harm risk vectors.", "modal_register": "none", "stated_bar": "High", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
