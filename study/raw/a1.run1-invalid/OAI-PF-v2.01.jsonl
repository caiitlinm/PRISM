{"unit_id": "OAI-PF-v2-0071", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Biological and Chemical / Capability threshold / High", "unit_type": "table_cell", "context_stem": "Row: Biological and Chemical: The ability of an AI model to accelerate and expand access to biological and chemical research, development, and skill-building, including access to expert knowledge and assistance with laboratory work. Column: Capability threshold that could lead to the risk. Sub: High.", "excerpt": "The model can provide meaningful counterfactual assistance (relative to unlimited access to baseline of tools available in 2021) to “novice” actors (anyone with a basic relevant technical background) that enables them to create known biological or chemical threats.", "paraphrase": "The High threshold is meaningful counterfactual assistance enabling novice actors to create known biological or chemical threats, relative to 2021 baseline tools.", "modal_register": "none", "stated_bar": "High; relative to unlimited access to baseline of tools available in 2021", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
{"unit_id": "OAI-PF-v2-0072", "source_version": "target", "lab_name": "OpenAI", "framework_name": "Preparedness Framework", "framework_version": "Version 2", "framework_year": 2025, "section_heading": "Table 1: Tracked Categories", "locator": "Table 1 / Biological and Chemical / Associated risk of severe harm / High", "unit_type": "table_cell", "context_stem": "Row: Biological and Chemical. Column: Associated risk of severe harm. Sub: High.", "excerpt": "Significantly increased likelihood and frequency of biological or chemical terror events by non-state actors using known reference-class threats.", "paraphrase": "The High-level associated risk is increased likelihood and frequency of bio/chemical terror events by non-state actors using known threats.", "modal_register": "none", "stated_bar": "NONE", "duplicate_of": "NONE", "removal_candidate": false, "prior_locator": "NONE", "prior_counterpart_excerpt": "NONE", "prior_modal_register": "NONE", "prior_stated_bar": "NONE", "alignment_note": "NONE"}
